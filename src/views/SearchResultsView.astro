---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import { pathFor } from '../lib/routes';
import type { Locale } from '../lib/taxonomy';

interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
const base = import.meta.env.BASE_URL;
---

<SiteLayout locale={locale} route={{ type: 'search' }} description={en ? 'Search all Interview Compass questions and browse every matching result.' : '搜索 Interview Compass 全部面试问题，浏览所有匹配结果。'}>
  <header class="search-page-heading">
    <p class="eyebrow">{en ? 'QUESTION DISCOVERY' : '发现问题'}</p>
    <h1 class="page-title">{en ? 'Search results' : '搜索结果'}</h1>
    <p class="intro">{en ? 'Browse every matching question. Your query and page are kept in the address bar.' : '浏览所有匹配问题；关键词和页码会保留在地址栏，方便继续阅读和分享。'}</p>
  </header>
  <p id="search-page-status" class="result-count" role="status" aria-live="polite">{en ? 'Loading search index…' : '正在载入搜索索引…'}</p>
  <ol id="search-page-results" class="search-page-results" aria-label={en ? 'Matching questions' : '匹配问题'}></ol>
  <p id="search-page-empty" class="empty-state" hidden>{en ? 'No questions matched this phrase. Try fewer words or browse the full library.' : '没有找到匹配的问题。可以减少关键词，或按筛选条件浏览全量题库。'}</p>
  <div id="search-page-actions" class="search-page-actions" hidden>
    <a href={pathFor({ type: 'questions' }, locale, base)}>{en ? 'Browse the full question library' : '浏览全量题库'} <Icon name="arrow-right" size={16} /></a>
    <button id="search-page-retry" type="button">{en ? 'Retry search' : '重试搜索'}</button>
  </div>
  <nav id="search-page-pagination" class="library-pagination" aria-label={en ? 'Search result pages' : '搜索结果分页'} hidden>
    <button id="search-page-previous" type="button">{en ? 'Previous page' : '上一页'}</button>
    <span id="search-page-number" role="status"></span>
    <button id="search-page-next" type="button">{en ? 'Next page' : '下一页'}</button>
  </nav>
  <noscript><p class="empty-state">{en ? 'Search requires JavaScript. You can browse the full question library instead.' : '搜索需要启用 JavaScript；也可以直接浏览全量题库。'}</p></noscript>

  <script>
    import { getPageWindow } from '../lib/search-pagination';
    import { safeSearchResultHref } from '../lib/search-records';

    type SearchData = { url: string; meta?: { title?: string }; excerpt?: string };
    type SearchResult = { url: string; data: () => Promise<SearchData> };
    type PagefindIndex = { search: (query: string, options: { filters: { locale: string } }) => Promise<{ results: SearchResult[] }> };

    const status = document.querySelector<HTMLElement>('#search-page-status')!;
    const list = document.querySelector<HTMLOListElement>('#search-page-results')!;
    const empty = document.querySelector<HTMLElement>('#search-page-empty')!;
    const actions = document.querySelector<HTMLElement>('#search-page-actions')!;
    const pagination = document.querySelector<HTMLElement>('#search-page-pagination')!;
    const pageNumber = document.querySelector<HTMLElement>('#search-page-number')!;
    const previous = document.querySelector<HTMLButtonElement>('#search-page-previous')!;
    const next = document.querySelector<HTMLButtonElement>('#search-page-next')!;
    const retry = document.querySelector<HTMLButtonElement>('#search-page-retry')!;
    const input = document.querySelector<HTMLInputElement>('#site-search');
    const base = import.meta.env.BASE_URL.replace(/\/$/, '');
    const locale = document.documentElement.lang;
    const en = locale === 'en';
    const pageSize = 20;
    let pagefind: PagefindIndex | undefined;
    let request = 0;

    async function render() {
      const currentRequest = ++request;
      const params = new URLSearchParams(location.search);
      const query = (params.get('q') ?? '').trim();
      const requestedPage = Number.parseInt(params.get('page') ?? '1', 10);
      if (input) input.value = query;
      list.replaceChildren();
      empty.hidden = true;
      actions.hidden = true;
      pagination.hidden = true;
      retry.hidden = true;

      if (!query) {
        status.textContent = en ? 'Enter a keyword in the search box above.' : '在上方搜索框输入问题、主题或关键词。';
        return;
      }

      status.textContent = en ? 'Searching all indexed pages…' : '正在检索全部索引内容…';
      try {
        pagefind ??= await import(/* @vite-ignore */ `${base}/pagefind/pagefind.js`) as PagefindIndex;
        const response = await pagefind.search(query, { filters: { locale } });
        if (currentRequest !== request) return;
        const window = getPageWindow(response.results.length, requestedPage, pageSize);
        if (window.page !== requestedPage && Number.isFinite(requestedPage)) {
          const corrected = new URL(location.href);
          if (window.page === 1) corrected.searchParams.delete('page');
          else corrected.searchParams.set('page', String(window.page));
          history.replaceState(null, '', `${corrected.pathname}${corrected.search}${corrected.hash}`);
        }
        const data = await Promise.all(response.results.slice(window.start, window.end).map((result) => result.data()));
        if (currentRequest !== request) return;

        const nodes = data.flatMap((item) => {
          const href = safeSearchResultHref(item.url, { origin: location.origin, basePath: base });
          if (!href) return [];
          const row = document.createElement('li');
          row.className = 'search-page-result';
          const link = document.createElement('a');
          link.href = href;
          link.className = 'search-page-result-title';
          link.textContent = item.meta?.title || item.url;
          const excerpt = document.createElement('p');
          excerpt.textContent = new DOMParser().parseFromString(item.excerpt ?? '', 'text/html').body.textContent ?? '';
          row.append(link, excerpt);
          return [row];
        });
        list.replaceChildren(...nodes);
        status.textContent = en
          ? `${response.results.length} matching results · Showing ${response.results.length ? window.start + 1 : 0}–${window.end}`
          : `${response.results.length} 条匹配结果 · 当前展示第 ${response.results.length ? window.start + 1 : 0}–${window.end} 条`;
        empty.hidden = response.results.length !== 0;
        actions.hidden = response.results.length !== 0;
        pagination.hidden = window.pageCount <= 1;
        pageNumber.textContent = en ? `Page ${window.page} of ${window.pageCount}` : `第 ${window.page} / ${window.pageCount} 页`;
        previous.disabled = window.page <= 1;
        next.disabled = window.page >= window.pageCount;
      } catch {
        status.textContent = en ? 'The search index could not be loaded.' : '搜索索引暂时无法载入。';
        actions.hidden = false;
        retry.hidden = false;
      }
    }

    function changePage(direction: number) {
      const nextPage = Math.max(1, Number.parseInt(new URLSearchParams(location.search).get('page') ?? '1', 10) + direction);
      const url = new URL(location.href);
      if (nextPage === 1) url.searchParams.delete('page');
      else url.searchParams.set('page', String(nextPage));
      history.pushState(null, '', `${url.pathname}${url.search}${url.hash}`);
      void render();
      status.scrollIntoView({ block: 'start' });
    }

    previous.addEventListener('click', () => changePage(-1));
    next.addEventListener('click', () => changePage(1));
    retry.addEventListener('click', () => { pagefind = undefined; void render(); });
    window.addEventListener('popstate', () => void render());
    const headerForm = document.querySelector<HTMLFormElement>('.search-form');
    headerForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      const query = input?.value.trim();
      if (!query) return;
      const url = new URL(location.href);
      url.search = '';
      url.searchParams.set('q', query);
      history.pushState(null, '', `${url.pathname}${url.search}`);
      void render();
      list.scrollIntoView({ block: 'start' });
    });
    void render();
  </script>
</SiteLayout>
