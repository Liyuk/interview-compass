---
import Icon from '../components/Icon.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getLevelMapping, validateCapabilityModel } from '../lib/capability-model';
import { pathFor, type RouteRef } from '../lib/routes';
import type { Locale } from '../lib/taxonomy';
interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
const base = import.meta.env.BASE_URL;
const mapping = getLevelMapping(locale);
const errors = validateCapabilityModel();
if (errors.length) throw new Error(`Invalid capability model: ${errors.join('; ')}`);
const route: RouteRef = { type: 'capability-model-mapping' };
const outline = [
  { id: 'mapping-sources-heading', label: en ? 'What these sources can tell you' : '两个来源各自能提供什么' },
  { id: 'mapping-checklist-heading', label: en ? 'A cautious comparison checklist' : '做职级对照时，至少核对这些条件' },
];
---
<SiteLayout locale={locale} route={route} description={en ? 'A cautious guide to partial cross-company level mapping.' : '了解跨公司职级映射可以比较什么，以及它的边界。'} outline={outline}>
  <p class="eyebrow">{en ? 'PARTIAL COMPARISON · NOT A RUBRIC' : '部分对照 · 不是晋升标准'}</p>
  <h1 class="page-title">{en ? 'Cross-company level mapping' : '跨公司职级映射：可比范围与边界'}</h1>
  <p class="source-date">{mapping.reviewDate}</p>
  <p class="intro">{mapping.intro}</p>

  <section class="model-section" aria-labelledby="mapping-sources-heading">
    <div class="model-section-heading">
      <div><p class="eyebrow">{en ? 'External references' : '外部参考'}</p><h2 id="mapping-sources-heading">{en ? 'What these sources can tell you' : '两个来源各自能提供什么'}</h2></div>
      <p>{en ? 'Use them as discovery and comparison aids. Neither publishes a complete, authoritative promotion rubric for every role.' : '它们适合用来发现职级名称和对照线索；都不能代表每个岗位完整、权威的晋升能力标准。'}</p>
    </div>
    <div class="mapping-grid mapping-grid-two">
      {mapping.references.map((reference) => <article class="mapping-card">
        <h3>{reference.name}</h3>
        <p>{reference.summary}</p>
        <strong>{en ? 'Comparison basis' : '可用的比较线索'}</strong>
        <p>{reference.basis}</p>
        <strong>{en ? 'Limit' : '边界'}</strong>
        <p>{reference.limitation}</p>
        <a href={reference.url} target="_blank" rel="noreferrer">{reference.source} <Icon name="arrow-up-right" size={16} /></a>
      </article>)}
    </div>
  </section>

  <section class="model-section">
    <h2 id="mapping-checklist-heading">{en ? 'A cautious comparison checklist' : '做职级对照时，至少核对这些条件'}</h2>
    <div class="mapping-factors">{mapping.factors.map((factor, index) => <div><span>{String(index + 1).padStart(2, '0')}</span><strong>{factor}</strong></div>)}</div>
    <div class="mapping-caution"><ul>{mapping.caveats.map((caveat) => <li>{caveat}</li>)}</ul></div>
  </section>

  <aside class="model-callout">
    <div><p class="eyebrow">{en ? 'Capability model' : '能力模型'}</p><strong>{en ? 'Our capability model is an editorial heuristic for organizing questions, not a company level conversion.' : '本站能力模型是整理题库用的启发式草稿，不是公司职级换算表。'}</strong></div>
    <a class="button-link" href={pathFor({ type: 'capability-model' }, locale, base)}>{en ? 'View the model' : '查看本站模型'} <Icon name="arrow-right" size={16} /></a>
  </aside>
</SiteLayout>
