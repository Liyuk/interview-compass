---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import QuestionList from '../components/QuestionList.astro';
import { bands, crossDomainPaths, domains, facetDefinitions, pick, type Locale } from '../lib/taxonomy';
import { pathFor } from '../lib/routes';
import { capabilityCounts } from '../lib/question-catalog';
import { loadQuestions } from '../lib/site-data';

interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
const base = import.meta.env.BASE_URL;
const questions = await loadQuestions(locale);
const counts = capabilityCounts(questions, locale);
const featured = domains.flatMap((domain) => questions.filter((q) => q.primaryCapability.startsWith(`${domain.id}.`)).slice(0, 1)).slice(0, 8);
const entries = [
  { number: '01', ref: { type: 'topics' } as const, title: en ? 'Topics' : '主题', text: en ? 'Start with a subject: systems, data, growth, or people.' : '从系统、数据、增长或团队等主题开始。' },
  { number: '02', ref: { type: 'roles' } as const, title: en ? 'Roles' : '岗位', text: en ? 'Browse questions for your role and discipline.' : '按你的岗位与职能浏览问题。' },
  { number: '03', ref: { type: 'scenarios' } as const, title: en ? 'Scenarios' : '场景', text: en ? 'Prepare, interview, reflect, or discuss promotion.' : '用于求职准备、面试设计、自我复盘或晋升讨论。' },
  { number: '04', ref: { type: 'capabilities' } as const, title: en ? 'Capabilities' : '能力', text: en ? 'See the judgment and craft each question explores.' : '查看每道题想了解的判断与专业能力。' },
];
---
<SiteLayout locale={locale} route={{ type: 'home' }} description={en ? 'A bilingual library of interview and promotion questions, organized by the capability each one examines.' : '按能力组织的中英文面试与晋升问题库。'}>
  <section class="hero hero-compass" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="eyebrow">{en ? 'INTERVIEW AND PROMOTION QUESTION LIBRARY' : '面试与晋升问题库'}</p>
      <h1 id="home-title" class="page-title">{en ? 'Find the question. Understand what it reveals.' : '找到问题，也看懂它想了解什么。'}</h1>
      <p class="intro">{en ? 'A bilingual library for exploring interview and promotion questions. Each card explains its intent and the signals to notice, so you can prepare or design a better conversation without model answers.' : '一套中英文面试与晋升问题库。每道题都说明考察意图和观察信号，帮助你准备经历，也帮助面试官设计更有效的对话；这里不提供标准答案。'}</p>
      <div class="hero-actions">
        <a class="hero-primary" href={pathFor({ type: 'questions' }, locale, base)}>{en ? 'Browse all questions' : '浏览全部问题'} <Icon name="arrow-up-right" size={17} /></a>
        <span class="hero-count">{en ? `${questions.length} questions · ${domains.length} capability areas` : `${questions.length} 道问题 · ${domains.length} 个能力域`}</span>
      </div>
    </div>
    <nav class="hero-entry-panel" aria-labelledby="entry-title">
      <div class="hero-entry-heading">
        <h2 id="entry-title">{en ? 'Choose where to begin' : '选择一个入口'}</h2>
        <span>{en ? 'FOUR LENSES' : '四种视角'}</span>
      </div>
      <div class="hero-entry-grid">
        {entries.map((entry) => (
          <a class="hero-entry" href={pathFor(entry.ref, locale, base)}>
            <span class="hero-entry-number">{entry.number}</span>
            <strong>{entry.title}<Icon name="arrow-up-right" size={15} /></strong>
            <span class="hero-entry-description">{entry.text}</span>
          </a>
        ))}
      </div>
      <p class="hero-entry-note">{en ? `Also searchable by ${facetDefinitions.topics.length} topics and ${facetDefinitions.roles.length} roles.` : `也可以按 ${facetDefinitions.topics.length} 个主题和 ${facetDefinitions.roles.length} 类岗位筛选。`}</p>
    </nav>
  </section>

  {crossDomainPaths.map((path) => (
    <section class="cross-path" aria-labelledby={`path-${path.id}`}>
      <h2 id={`path-${path.id}`} class="section-title">{pick(path.name, locale)}</h2>
      <p class="intro">{pick(path.description, locale)}</p>
      <a class="text-link" href={pathFor({ type: 'path', id: path.id }, locale, base)}>{en ? 'Open this path' : '查看这条路径'} <Icon name="chevron-right" size={16} /></a>
    </section>
  ))}

  <section aria-labelledby="map-title">
    <h2 id="map-title" class="section-title">{en ? 'Capability map' : '能力地图'}</h2>
    {bands.map((band) => (
      <div class="band">
        <h3>{pick(band.name, locale)}</h3>
        <p class="band-text">{pick(band.description, locale)}</p>
        <div class="facet-grid three">
          {domains.filter((domain) => domain.band === band.id).map((domain) => {
            const count = counts.domains.get(domain.id) ?? 0;
            return count > 0
              ? <a class="facet-card" href={pathFor({ type: 'domain', domain: domain.id }, locale, base)}><strong>{domain.letter} · {pick(domain.name, locale)}</strong><span>{pick(domain.description, locale)}</span><span class="count">{en ? `${count} questions` : `${count} 道问题`}</span></a>
              : <div class="facet-card muted"><strong>{domain.letter} · {pick(domain.name, locale)}</strong><span>{en ? 'Questions are being added.' : '题目整理中。'}</span></div>;
          })}
        </div>
      </div>
    ))}
  </section>

  <section aria-labelledby="featured-title">
    <h2 id="featured-title" class="section-title">{en ? 'A few to begin with' : '先从这几道看起'}</h2>
    <QuestionList questions={featured} locale={locale} />
    <p><a class="text-link" href={pathFor({ type: 'questions' }, locale, base)}>{en ? `Browse all ${questions.length} questions` : `浏览全部 ${questions.length} 道问题`} <Icon name="chevron-right" size={16} /></a></p>
  </section>
</SiteLayout>
