---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import { domains, facetDefinitions, type Locale } from '../lib/taxonomy';
import { pathFor } from '../lib/routes';
import { questionCollections } from '../lib/question-collections';
import { pick } from '../lib/taxonomy';
import { loadQuestions } from '../lib/site-data';
interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
const base = import.meta.env.BASE_URL;
const questions = await loadQuestions(locale);
const featured = ['general-interview', 'technical-selected', 'candidate-due-diligence'].flatMap((id) => questionCollections.find((item) => item.id === id) ?? []);
const goals = [
  ['candidate', '候选人求职', 'Job candidate', '准备重点经历、专业问题与反问。', 'Prepare experience, professional questions, and due diligence.'],
  ['interviewer', '招聘面试官', 'Interviewer', '从岗位画像选择主问、追问与证据。', 'Choose lead questions and probes for the role you are hiring.'],
  ['promotion-candidate', '晋升候选人', 'Promotion candidate', '对照目标责任，整理持续贡献。', 'Gather sustained evidence for your target responsibilities.'],
  ['promotion-reviewer', '晋升评审者', 'Promotion reviewer', '核实责任、结果与个人作用。', 'Examine responsibility, outcomes, and personal contribution.'],
  ['self-practice', '自我训练与复盘', 'Self-practice', '选择一个思考目标，发现证据缺口。', 'Focus on one thinking skill and identify missing evidence.'],
  ['project-review', '项目与运营复盘', 'Project review', '比较目标与结果，找到下一步行动。', 'Compare goals with outcomes and identify the next action.'],
];
const entries = [
  { ref: { type: 'roles' } as const, title: en ? 'Roles' : '岗位', text: en ? 'Find questions relevant to your work.' : '按职能找到相关实践问题。' },
  { ref: { type: 'topics' } as const, title: en ? 'Topics' : '主题', text: en ? 'Explore a subject or working method.' : '查找技术、业务或方法主题。' },
  { ref: { type: 'capabilities' } as const, title: en ? 'Capabilities' : '能力', text: en ? 'Understand what a question examines.' : '看懂问题主要在考察什么。' },
  { ref: { type: 'capability-model' } as const, title: en ? 'Stages' : '阶段', text: en ? 'Compare responsibility and evidence.' : '对照责任范围和行为要求。' },
];
---
<SiteLayout locale={locale} route={{ type: 'home' }} description={en ? 'Learn to compare options, examine evidence, and explain your contribution through interview and promotion questions.' : '通过面试与晋升问题，学习比较思路、核实证据、发现并体现真实贡献。'}>
  <div class="home-page">
  <section class="hero hero-compass" aria-labelledby="home-title">
    <div class="hero-copy">
      <h1 id="home-title" class="page-title">{en ? 'Find the question. Understand what it reveals.' : '找到问题，也看懂它想了解什么。'}</h1>
      <p class="intro">{en ? 'Start with your goal and role. Use a few relevant questions to compare approaches, examine evidence, and explain your contribution.' : '从你的目标和岗位开始，用一小组相关问题，学习多种思路的比较、核实证据、发现并体现自己的贡献。'}</p>
      <div class="hero-actions">
        <a class="hero-primary" href={pathFor({ type: 'scenarios' }, locale, base)}>{en ? 'Choose your goal' : '按目标开始'} <Icon name="arrow-up-right" size={17} /></a>
        <a class="hero-secondary" href={pathFor({ type: 'collections' }, locale, base)}>{en ? 'Curated sets' : '从精选题单开始'}</a>
      </div>
      <p class="hero-count">{en ? `${questions.length} questions · Chinese and English · Explore only what you need` : `${questions.length} 道问题 · 中英双语 · 按需选择，不必读完整库`}</p>
    </div>
    <nav class="hero-entry-panel" aria-labelledby="entry-title">
      <div class="hero-entry-heading"><h2 id="entry-title">{en ? 'Already know what you need?' : '已经知道要找什么？'}</h2></div>
      <div class="hero-entry-grid">{entries.map((entry) => <a class="hero-entry" href={pathFor(entry.ref, locale, base)}><strong>{entry.title}<Icon name="arrow-up-right" size={15} /></strong><span class="hero-entry-description">{entry.text}</span></a>)}</div>
      <p class="hero-entry-note">{en ? `${facetDefinitions.topics.length} topics · ${facetDefinitions.roles.length} roles · ${domains.length} capability domains` : `${facetDefinitions.topics.length} 个主题 · ${facetDefinitions.roles.length} 类岗位 · ${domains.length} 个能力域`}</p>
    </nav>
  </section>
  <section class="home-goals" aria-labelledby="goals-title">
    <h2 id="goals-title" class="section-title">{en ? 'What are you here to do?' : '这次，你想完成什么？'}</h2>
    <p class="band-text">{en ? 'Choose a task, then follow the steps to questions that fit your role and responsibility.' : '先选当前任务，再按角色和责任范围找到相关问题。'}</p>
    <div class="goal-links">{goals.map(([id, zh, english, description, descriptionEn]) => <a href={`${pathFor({ type: 'scenarios' }, locale, base)}#${id}`}><strong>{en ? english : zh} <Icon name="arrow-up-right" size={16} /></strong><span>{en ? descriptionEn : description}</span></a>)}</div>
  </section>
  <section class="home-featured" aria-labelledby="featured-title">
    <div class="collection-section-heading"><h2 id="featured-title" class="section-title">{en ? 'Start with a few questions' : '先看一小组问题'}</h2><a href={pathFor({ type: 'collections' }, locale, base)}>{en ? 'All curated sets' : '全部精选题单'} <Icon name="chevron-right" size={16} /></a></div>
    <div class="featured-collection-grid">{featured.map((collection) => <a class="featured-collection" href={pathFor({ type: 'collection', id: collection.id }, locale, base)}><strong>{pick(collection.title, locale)} <Icon name="arrow-up-right" size={15} /></strong><span>{pick(collection.purpose, locale)}</span></a>)}</div>
  </section>
  <aside class="journey-next"><h2>{en ? 'A method behind the questions' : '问题背后，有一套判断方法'}</h2><p>{en ? 'Clarify the goal, compare approaches, ask about context and personal action, then examine outcomes and alternative explanations. Use the framework to ask and reflect, without model answers.' : '明确目标，比较多种思路，追问背景和本人行动，再核实结果、代价与其他解释。用这套框架提问和复盘，形成自己的判断。'}</p><div class="journey-links"><a href={pathFor({ type: 'framework' }, locale, base)}>{en ? 'Explore questioning methods' : '了解提问方法'}</a><a href={pathFor({ type: 'questions' }, locale, base)}>{en ? 'Browse the full library' : '浏览全量题库'}</a></div></aside>
  </div>
</SiteLayout>
