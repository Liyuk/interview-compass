---
import SiteLayout from '../layouts/SiteLayout.astro';
import QuestionList from '../components/QuestionList.astro';
import { domains, pick, type Locale } from '../lib/taxonomy';
import { pathFor } from '../lib/routes';
import { getQuestions } from '../lib/question-catalog';
import { loadQuestions } from '../lib/site-data';

interface Props { locale: Locale; domainId: string; leafId: string }
const { locale, domainId, leafId } = Astro.props;
const en = locale === 'en';
const base = import.meta.env.BASE_URL;
const domain = domains.find((item) => item.id === domainId)!;
const leaf = domain.leaves.find((item) => item.id === leafId)!;
const questions = getQuestions(await loadQuestions(locale), { locale, capability: `${domain.id}.${leaf.id}` });
const siblings = domain.leaves.filter((item) => item.id !== leaf.id);
---
<SiteLayout locale={locale} route={{ type: 'leaf', domain: domain.id, leaf: leaf.id }} description={pick(leaf.description, locale)}>
  <p class="eyebrow">{domain.letter} · {pick(domain.name, locale)}</p>
  <h1 class="page-title">{pick(leaf.name, locale)}</h1>
  <p class="intro">{pick(leaf.description, locale)}</p>
  <p class="result-count">{en ? `${questions.length} questions` : `${questions.length} 道问题`}</p>
  <QuestionList questions={questions} locale={locale} showCapability={false} />
  <p class="band-text"><a class="text-link" href={pathFor({ type: 'domain', domain: domain.id }, locale, base)}>{en ? 'Back to the whole domain' : '回到整个能力域'} ›</a></p>
</SiteLayout>
