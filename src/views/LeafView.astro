---
import SiteLayout from '../layouts/SiteLayout.astro';
import TargetCount from '../components/TargetCount.astro';
import Icon from '../components/Icon.astro';
import QuestionReading from '../components/QuestionReading.astro';
import { domains, pick, type Locale } from '../lib/taxonomy';
import { pathFor } from '../lib/routes';
import { getQuestions } from '../lib/question-catalog';
import { loadQuestions } from '../lib/site-data';

interface Props { locale: Locale; domainId: string; leafId: string }
const { locale, domainId, leafId } = Astro.props;
const en = locale === 'en';
const base = import.meta.env.BASE_URL;
const domain = domains.find((item) => item.id === domainId)!;
const leaf = domain.leaves.find((item) => item.id === leafId)!;
const questions = getQuestions(await loadQuestions(locale), { locale, capability: `${domain.id}.${leaf.id}` });
---
<SiteLayout locale={locale} route={{ type: 'leaf', domain: domain.id, leaf: leaf.id }} description={pick(leaf.description, locale)}>
  <p class="eyebrow">{domain.letter} · {pick(domain.name, locale)}</p>
  <h1 class="page-title">{pick(leaf.name, locale)}</h1>
  <p class="intro">{pick(leaf.description, locale)}</p>
  <section class="leaf-boundary" aria-labelledby="leaf-boundary-title">
    <h2 id="leaf-boundary-title">{en ? 'Classification boundary' : '分类边界'}</h2>
    <p><strong>{en ? 'Include' : '收录'}:</strong> {pick(leaf.placement, locale)}</p>
    <p><strong>{en ? 'Choose a neighboring leaf when' : '相邻分类判断'}:</strong> {pick(leaf.boundary, locale)}</p>
  </section>
  <p class="model-inline-link">{en ? 'This capability may be expected at different levels of responsibility.' : '这项能力可能会在不同阶段标准中以不同深度出现。'} <a href={pathFor({ type: 'capability-model' }, locale, base)}>{en ? 'Explore the career-stage model' : '查看阶段要求'} <Icon name="arrow-right" size={16} /></a></p>
  <p class="result-count"><TargetCount questions={questions} locale={locale} unit /></p>
  <QuestionReading questions={questions} locale={locale} />
  <p class="band-text"><a class="text-link" href={pathFor({ type: 'domain', domain: domain.id }, locale, base)}>{en ? 'Back to the whole domain' : '回到整个能力域'} <Icon name="chevron-right" size={16} /></a></p>
</SiteLayout>

<style>
  .leaf-boundary {
    margin: 1.75rem 0;
    padding: 1rem 1.25rem;
    border-inline-start: 3px solid var(--sl-color-accent);
    background: var(--sl-color-gray-6);
    border-radius: 0 var(--sl-border-radius) var(--sl-border-radius) 0;
  }
  .leaf-boundary h2 { margin: 0 0 0.65rem; font-size: 1rem; }
  .leaf-boundary p { margin: 0.4rem 0 0; color: var(--sl-color-gray-2); }
  .leaf-boundary strong { color: var(--sl-color-text); }
</style>
