---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import { tokensForQuestion } from '../lib/question-profile-data';
import { questionCollections } from '../lib/question-collections';
import { pathFor } from '../lib/routes';
import { pick, type Locale } from '../lib/taxonomy';
import { loadAllRecords } from '../lib/site-data';

interface Props { locale: Locale; id: string }
const { locale, id } = Astro.props;
const en = locale === 'en';
const base = import.meta.env.BASE_URL;
const collection = questionCollections.find((item) => item.id === id)!;
const records = collection.kind === 'question-set' ? await loadAllRecords() : [];
const questions = collection.kind === 'question-set' ? collection.entries.flatMap((entry) => {
  const record = records.find((item) => item.questionId === entry.questionId && item.locale === locale && item.status === 'published');
  return record ? [{ record, rationale: entry.rationale }] : [];
}) : [];
---

<SiteLayout locale={locale} route={{ type: 'collection', id }} description={pick(collection.purpose, locale)}>
  <header class="collection-detail-header">
    <p class="eyebrow">{collection.kind === 'candidate-guide' ? (en ? 'CANDIDATE DUE DILIGENCE' : '候选人反向提问') : (en ? 'CURATED QUESTION PATH' : '精选问题路径')}</p>
    <h1 class="page-title">{pick(collection.title, locale)}</h1>
    <p class="intro">{pick(collection.purpose, locale)}</p>
    <p class="collection-audience">{en ? 'For' : '适用对象'} · {pick(collection.audience, locale)}</p>
  </header>

  {collection.kind === 'question-set' ? (
    <section aria-labelledby="collection-questions-heading">
      <div class="collection-section-heading">
        <h2 id="collection-questions-heading" class="section-title">{en ? 'Follow this path' : '按这个顺序练习'}</h2>
        <a class="text-link" href={pathFor({ type: 'questions' }, locale, base)}>{en ? 'Open full library' : '查看全量题库'} <Icon name="arrow-up-right" size={16} /></a>
      </div>
      <div data-target-list data-target-content><ol class="collection-question-list">
        {questions.map(({ record, rationale }, index) => (
          <li data-question-id={record.questionId} data-question-profiles={tokensForQuestion(record.questionId).join(' ')}>
            <span class="collection-step-number" data-curated-number>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <a class="collection-question-link" href={pathFor({ type: 'question', questionId: record.questionId, capability: record.primaryCapability, title: record.question }, locale, base)}>{record.question}</a>
              <p class="collection-rationale"><strong>{en ? 'Why selected' : '选择理由'}</strong> {pick(rationale, locale)}</p>
            </div>
          </li>
        ))}
      </ol><p data-target-empty class="target-empty" hidden>{en ? 'This set has no questions for your target.' : '这个题单在当前目标下暂无匹配题。'} <button type="button" data-edit-target>{en ? 'Change target' : '切换目标'}</button> · <button type="button" data-view-all-target>{en ? 'View all questions' : '查看全部题目'}</button></p></div>
    </section>
  ) : (
    <div class="candidate-guide-content">
      <aside class="candidate-guide-note">
        <strong>{en ? 'Use these to make your decision' : '用这些问题帮助自己决策'}</strong>
        <p>{en ? 'Ask the questions that could change your decision. Request concrete examples and clarify what is known, expected, or still uncertain. These prompts do not score the interviewer or the organization.' : '优先询问那些答案可能改变你选择的问题。请对方给出具体例子，并分清已知事实、预期和不确定项。这些问题不是给面试官或组织打分。'}</p>
      </aside>
      {collection.sections.map((section) => (
        <section class="candidate-prompt-section" aria-labelledby={`prompt-group-${section.id}`}>
          <h2 id={`prompt-group-${section.id}`} class="section-title">{pick(section.title, locale)}</h2>
          <ol class="candidate-prompt-list">
            {section.prompts.map((prompt) => (
              <li class="candidate-prompt">
                <h3>{pick(prompt.question, locale)}</h3>
                <dl>
                  <div><dt>{en ? 'What this clarifies' : '想确认什么'}</dt><dd>{pick(prompt.purpose, locale)}</dd></div>
                  <div><dt>{en ? 'How it informs your choice' : '怎样用于自己的选择'}</dt><dd>{pick(prompt.decisionUse, locale)}</dd></div>
                  {prompt.followUp && <div><dt>{en ? 'Follow-up' : '可以继续追问'}</dt><dd>{pick(prompt.followUp, locale)}</dd></div>}
                </dl>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  )}
  <p class="collection-back-link"><a class="text-link" href={pathFor({ type: 'collections' }, locale, base)}><Icon name="arrow-left" size={16} /> {en ? 'All curated sets' : '全部精选题单'}</a></p>
</SiteLayout>
