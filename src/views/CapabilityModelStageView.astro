---
import Icon from '../components/Icon.astro';
import CapabilityReference from '../components/CapabilityReference.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { dimensionIds, getStageProfile, validateCapabilityModel, type StageId } from '../lib/capability-model';
import { pathFor, type RouteRef } from '../lib/routes';
import type { Locale } from '../lib/taxonomy';
interface Props { locale: Locale; stage: StageId }
const { locale, stage: stageId } = Astro.props;
const en = locale === 'en';
const base = import.meta.env.BASE_URL;
const errors = validateCapabilityModel();
if (errors.length) throw new Error(`Invalid capability model: ${errors.join('; ')}`);
const stage = getStageProfile(stageId, locale);
const standards = dimensionIds.map((id) => ({ id, name: id, standards: stage.dimensions[id] }));
const dimensionNames = { 'business-results': en ? 'Business outcomes' : '业务结果', 'domain-expertise': en ? 'Domain expertise' : '专业领域知识', 'team-influence': en ? 'Team influence' : '团队影响力', 'human-competitive-advantage': en ? 'Human competitiveness' : '人的竞争力' };
const dimensionGuidance = [
  { id: 'business-results', title: dimensionNames['business-results'], description: en ? 'Understand the people served and intended outcomes, make evidence-based trade-offs, and verify contribution. For platform, infrastructure, reliability, and safety work, cost, efficiency, risk reduction, and internal-user outcomes count; direct revenue ownership is not universal.' : '理解服务对象和目标，基于证据取舍并验证贡献。平台、基础设施、可靠性和安全工作可用成本、效率、风险降低及内部用户效果衡量，不要求人人直接负责收入。' },
  { id: 'domain-expertise', title: dimensionNames['domain-expertise'], description: en ? 'Apply relevant knowledge to diagnose, design, implement or review, validate quality, and make evolution decisions. The professional leaves required depend on the role.' : '将岗位相关知识用于问题诊断、方案设计、实现或评审、质量验证与演进判断；具体专业叶子由岗位决定。' },
  { id: 'team-influence', title: dimensionNames['team-influence'], description: en ? 'Help others work effectively through communication, coordination, review, shared methods, coaching, or organizational mechanisms. IC influence is not measured by direct reports; managers also own formal people responsibilities.' : '通过沟通、协调、评审、共享方法、辅导或组织机制让他人更有效。专业贡献者不以直属人数衡量；管理者还需承担正式人员管理责任。' },
  { id: 'human-competitive-advantage', title: dimensionNames['human-competitive-advantage'], description: en ? 'Observe questioning, reasoning, learning transfer, judgment updates, relationship handling, and recovery in work. This is not a fixed personality or potential verdict; do not infer it from extroversion, fluent speech, or willingness to overwork.' : '从工作中观察提问、推理、学习迁移、更新判断、处理关系和受挫恢复。它不是人格优劣或潜力定论，不能从外向、表达流利或是否愿意超时工作推断。' },
];
const evidenceFramework = en
  ? ['Context and goal', 'Role and authority', 'Judgment and trade-offs', 'Actions and collaborators', 'Outcome and guardrails', 'Attribution limits', 'Counterevidence and adjustment']
  : ['背景与目标', '本人角色与权限', '判断与取舍', '行动与协作者', '结果与护栏', '归因限制', '反证与后续调整'];
const next = stage.nextStageIds.map((id) => getStageProfile(id, locale));
const route: RouteRef = { type: 'capability-model-stage', stage: stageId };
const outline = [
  { id: 'dimension-guidance-heading', label: en ? 'Four complementary evaluation lenses' : '四个互补的评价视角' },
  { id: 'evidence-framework-heading', label: en ? 'Evidence to verify' : '面试中需要核验的证据链' },
];
---
<SiteLayout locale={locale} route={route} description={stage.summary} outline={outline}>
  <header class="model-detail-header"><p class="eyebrow">{en ? 'Stage profile' : '阶段能力画像'} · {stage.track === 'ic' ? (en ? 'Individual contributor' : '专业贡献路径') : (en ? 'Management' : '管理路径')}</p><h1 class="page-title">{stage.name}</h1><p class="intro">{stage.summary}</p></header>
  <p class="model-note">{en ? 'Read these as observable expectations across repeated work, not as a checklist for a single project. First distinguish whether the role expects the work, whether the person had a chance to demonstrate it, and whether the evidence supports the claim. Lack of opportunity or evidence is not itself a negative judgment. AI use is judged by verified outcomes, sound boundaries, and the quality of decisions; choosing not to use AI can be sound.' : '以下是通过多个工作周期观察的行为标准，不是单个项目的打勾清单。先区分岗位是否要求、当事人是否有展示机会、现有证据是否支持判断；没有机会或证据不足本身不等于能力不达标。AI 相关要求看结果验证、边界意识和决策质量；判断不采用 AI 也可能是合理表现。'}</p>
  <section class="model-section dimension-guidance" aria-labelledby="dimension-guidance-heading"><div class="model-section-heading"><h2 id="dimension-guidance-heading">{en ? 'Four complementary evaluation lenses' : '四个互补的评价视角'}</h2></div><p class="model-note">{en ? 'These lenses and the A–H capability map answer different questions. One experience may provide evidence across lenses, but do not count the same result multiple times.' : '四个评价视角与 A–H 能力分类回答不同问题。同一经历可以提供多个视角的证据，但不要把同一结果重复计功。'}</p><div class="dimension-guidance-grid">{dimensionGuidance.map((item) => <article><h3>{item.title}</h3><p>{item.description}</p></article>)}</div></section>
  <section class="evidence-framework" aria-labelledby="evidence-framework-heading"><h2 id="evidence-framework-heading">{en ? 'Evidence to verify' : '面试中需要核验的证据链'}</h2><p>{en ? 'Use this structure to understand a real example. Strong judgment can appear in a failed project; a successful result alone does not prove personal causation.' : '用这条结构理解真实经历。失败项目也可能体现优质判断；项目成功本身不能证明结果由候选人个人造成。'}</p><ol>{evidenceFramework.map((item) => <li>{item}</li>)}</ol></section>
  <p class="model-note">{en ? 'The labels beside capability references describe that capability’s role in this standard; they do not make the whole standard optional. Any role or scenario condition is stated separately.' : '能力引用旁的标签只说明该能力在当前标准中的作用，不表示整条标准可选。岗位或情境的适用条件会单独说明。'}</p>
  <div class="standard-sections">{standards.map((dimension) => <section class="standard-section"><div class="standard-heading"><span>{dimensionNames[dimension.id as keyof typeof dimensionNames]}</span><a href={pathFor({ type: 'capability-model-dimension', dimension: dimension.id }, locale, base)}>{en ? 'View progression' : '查看维度变迁'} <Icon name="arrow-right" size={16} /></a></div><ol class="standard-list">{dimension.standards.map((standard) => <li id={standard.id}><strong>{standard.text}</strong>{standard.applicability && <p class="applicability-note"><span>{en ? 'Applies when: ' : '适用条件：'}</span>{standard.applicability}</p>}{standard.evidence && <p><span>{en ? 'Evidence to inspect: ' : '观察证据：'}</span>{standard.evidence}</p>}<div class="capability-links"><span>{en ? 'Capability map and its role here' : '能力地图及其在此处的作用'}：</span>{standard.capabilities.map((reference) => <CapabilityReference capability={reference.id} emphasis={reference.emphasis} locale={locale} base={base} />)}</div></li>)}</ol></section>)}</div>
  {next.length > 0 && <nav class="stage-next" aria-label={en ? 'Next stages' : '后续阶段'}><span>{en ? 'Possible next stages' : '可能的后续阶段'}</span>{next.map((item) => <a href={pathFor({ type: 'capability-model-stage', stage: item.id }, locale, base)}>{item.name} <Icon name="arrow-right" size={16} /></a>)}</nav>}
</SiteLayout>
