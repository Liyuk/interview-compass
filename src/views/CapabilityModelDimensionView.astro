---
import Icon from '../components/Icon.astro';
import CapabilityReference from '../components/CapabilityReference.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getDimensionProgression, validateCapabilityModel, type CapabilityDimensionId } from '../lib/capability-model';
import { pathFor, type RouteRef } from '../lib/routes';
import type { Locale } from '../lib/taxonomy';
interface Props { locale: Locale; dimension: CapabilityDimensionId }
const { locale, dimension: dimensionId } = Astro.props;
const en = locale === 'en';
const base = import.meta.env.BASE_URL;
const errors = validateCapabilityModel();
if (errors.length) throw new Error(`Invalid capability model: ${errors.join('; ')}`);
const progression = getDimensionProgression(dimensionId, locale);
const paths = [
  {
    id: 'ic',
    title: en ? 'Individual contributor path' : '专业贡献路径',
    note: en ? 'The IC path grows from scoped tasks to broader technical and organizational influence.' : '专业贡献路径从明确范围内的工作，逐步扩展到领域和组织影响。',
    stages: progression.stages.filter(({ stage }) => stage.track === 'ic'),
  },
  {
    id: 'management',
    title: en ? 'Management path branches from Senior Engineer' : '管理路径从高级工程师处分叉',
    note: en ? 'People management is a separate path, with its own progression through managers and teams.' : '人员管理是独立路径，后续通过管理者和团队扩大责任范围。',
    stages: progression.stages.filter(({ stage }) => stage.track !== 'ic'),
  },
];
const route: RouteRef = { type: 'capability-model-dimension', dimension: dimensionId };
---
<SiteLayout locale={locale} route={route} description={en ? `Stage expectations for ${progression.name}.` : `${progression.name}在六个发展阶段的行为要求。`}>
  <header class="model-detail-header"><p class="eyebrow">{en ? 'Dimension progression' : '能力维度变迁'}</p><h1 class="page-title">{progression.name}</h1><p class="intro">{en ? 'Expectations change in scope, autonomy, ambiguity, and leverage. A higher stage means a different level of impact, not simply more tasks.' : '要求随责任范围、自主性、问题模糊度与影响杠杆变化。阶段提升意味着影响方式发生变化，不只是承担更多任务。'}</p></header>
  {paths.map((path) => (
    <section class="progression-path" aria-labelledby={`${path.id}-path-heading`}>
      <h2 id={`${path.id}-path-heading`}>{path.title}</h2>
      <p class="progression-summary">{path.note}</p>
      <div class="progression-list">{path.stages.map(({ stage, standards }, index) => (
        <article class="progression-stage">
          <div class="progression-marker"><span>{String(index + 1).padStart(2, '0')}</span></div>
          <div class="progression-content">
            <div class="progression-title"><h3>{stage.name}</h3><a href={pathFor({ type: 'capability-model-stage', stage: stage.id }, locale, base)}>{en ? 'Full stage profile' : '完整阶段画像'} <Icon name="arrow-right" size={16} /></a></div>
            <p class="progression-summary">{stage.summary}</p>
            <ul>{standards.map((standard) => <li><strong>{standard.text}</strong>{standard.evidence && <small>{en ? 'Evidence: ' : '观察证据：'}{standard.evidence}</small>}<div class="capability-links">{standard.capabilities.map((reference) => <CapabilityReference capability={reference.id} locale={locale} base={base} />)}</div></li>)}</ul>
          </div>
        </article>
      ) )}</div>
    </section>
  ))}
</SiteLayout>
