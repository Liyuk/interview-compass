---
import Icon from '../components/Icon.astro';
import PlanningOverview from '../components/PlanningOverview.astro';
import CapabilityMatrix from '../components/CapabilityMatrix.astro';
import RoleStageExplorer from '../components/RoleStageExplorer.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { dimensionIds, getDimensionProgression, getStageProfile, stageIds, validateCapabilityModel } from '../lib/capability-model';
import { pathFor, type RouteRef } from '../lib/routes';
import type { Locale } from '../lib/taxonomy';
interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
const base = import.meta.env.BASE_URL;
const errors = validateCapabilityModel();
if (errors.length) throw new Error(`Invalid capability model: ${errors.join('; ')}`);
const stages = stageIds.map((id) => getStageProfile(id, locale));
const icStages = stages.filter((stage) => stage.track === 'ic');
const managementStages = stages.filter((stage) => stage.track !== 'ic');
const dimensions = dimensionIds.map((id) => getDimensionProgression(id, locale));
const route: RouteRef = { type: 'capability-model' };
const outline = [
  { id: 'stage-heading', label: en ? 'Scope and leverage expand with each stage' : '阶段变化体现为责任范围与影响方式的扩展' },
  { id: 'dimension-heading', label: en ? 'Four dimensions, connected to the A–H map' : '四个评价维度，连接站内 A–H 能力地图' },
];
---
<SiteLayout locale={locale} route={route} description={en ? 'An editorial capability heuristic for organizing interview questions.' : '用于组织面试问题的启发式能力模型草稿。'} outline={outline}>
  <section class="model-hero">
    <p class="eyebrow">{en ? 'INTERVIEW COMPASS EDITORIAL DRAFT' : 'INTERVIEW COMPASS · 启发式草稿'}</p>
    <h1 class="page-title">{en ? 'Deliver outcomes. Use sound judgment. Grow your impact.' : '创造业务结果，建设判断力与人的竞争力'}</h1>
    <p class="intro">{en ? 'This working framework organizes the question library; it is not an externally validated standard or a substitute for your organization’s promotion criteria. AI can increase execution capacity. Human judgment, accountability, and relationships shape the outcomes that capacity produces.' : '这是为组织本站题库而整理的通用启发式草稿，未经过外部标准验证，也不能替代所在组织的晋升能力模型。AI 扩大执行能力，而人的判断、责任和关系建设影响这些能力如何转化为结果。'}</p>
    <div class="model-principles"><span>{en ? 'Business outcomes' : '业务结果'}</span><span>{en ? 'Domain expertise' : '专业领域知识'}</span><span>{en ? 'Team influence' : '团队影响力'}</span><span>{en ? 'Human skills and judgment' : '人的竞争力'}</span></div>
    <p class="model-note">{en ? 'AI-related skills appear across all four dimensions; they are not a separate maturity ladder.' : 'AI 能力贯穿四个维度，不单独形成一条工具熟练度阶梯。人的竞争力通过学习方式、思考质量、判断力与关系处理来观察。'}</p>
  </section>
  <RoleStageExplorer locale={locale} />
  <p class="model-note">{en ? 'The six-stage profiles and A–H matrix below describe engineering roles. Use the specialization profiles above for role-specific evidence. Product, operations, and design appear as perspectives that broaden engineers’ business understanding and collaboration; they are not separate career ladders here.' : '下面的六阶段详细画像和 A–H 矩阵描述工程岗位；不同工程方向可从上方入口查看；产品、运营和设计内容用于业务理解与协作，不另设职能晋升路径。'}</p>
  <section class="model-section" aria-labelledby="stage-heading">
    <div class="model-section-heading"><div><p class="eyebrow">{en ? 'Career progression' : '阶段变迁'}</p><h2 id="stage-heading">{en ? 'Responsibility and impact grow at each stage' : '阶段变化体现为责任范围与影响方式的扩展'}</h2></div><p>{en ? 'Individual-contributor and management roles are distinct career tracks. The titles shown here are illustrative; companies define their own levels and promotion criteria.' : '高级工程师之后，资深工程师与工程管理者是不同发展路径；管理管理者通过多个管理者扩大组织结果。'}</p></div>
    <h3 class="track-heading">{en ? 'Individual contributor track' : '专业贡献路径'} <span>{en ? 'Junior Software Engineer → Software Engineer → Senior Software Engineer → Staff Software Engineer' : '初级工程师 → 中级工程师 → 高级工程师 → 资深工程师'}</span></h3>
    <div class="stage-grid stage-grid-four">{icStages.map((stage) => <a class="stage-card" href={pathFor({ type: 'capability-model-stage', stage: stage.id }, locale, base)}><span class="stage-track">{en ? 'Individual contributor' : '专业贡献路径'}</span><strong>{stage.name}</strong><p>{stage.summary}</p><span class="stage-link">{en ? 'View standards' : '查看阶段标准'} <Icon name="arrow-right" size={16} /></span></a>)}</div>
    <h3 class="track-heading management-track-heading">{en ? 'Engineering management track' : '管理路径'} <span>{en ? 'A separate path from individual-contributor roles' : '从高级专业贡献分流'}</span></h3>
    <div class="stage-grid management-stage-grid">{managementStages.map((stage) => <a class="stage-card" href={pathFor({ type: 'capability-model-stage', stage: stage.id }, locale, base)}><span class="stage-track">{stage.track === 'engineering-management' ? (en ? 'Engineering management' : '工程管理') : (en ? 'Organization leadership' : '组织管理')}</span><strong>{stage.name}</strong><p>{stage.summary}</p><span class="stage-link">{en ? 'View standards' : '查看阶段标准'} <Icon name="arrow-right" size={16} /></span></a>)}</div>
  </section>
  <details class="reference-disclosure">
    <summary>{en ? 'Explore shared planning reference and the full responsibility matrix' : '展开共用规划参考与完整责任矩阵'}</summary>
    <PlanningOverview locale={locale} />
    <CapabilityMatrix locale={locale} />
  </details>
  <section class="model-section" aria-labelledby="dimension-heading">
    <div class="model-section-heading"><div><p class="eyebrow">{en ? 'Capability map' : '能力地图'}</p><h2 id="dimension-heading">{en ? 'Four dimensions connected to the A–H capability map' : '四个评价维度，连接站内 A–H 能力地图'}</h2></div><p>{en ? 'Each standard links to the observable capabilities it draws on.' : '维度描述阶段期待，A–H 能力叶子描述可发展的具体能力。每条标准都回连到相应能力叶子。'}</p></div>
    <div class="dimension-grid">{dimensions.map((dimension) => <a class="dimension-card" href={pathFor({ type: 'capability-model-dimension', dimension: dimension.id }, locale, base)}><span>{dimension.stages.reduce((sum, item) => sum + item.standards.length, 0)} {en ? 'stage standards' : '条阶段标准'}</span><strong>{dimension.name}</strong><p>{dimension.stages[0]?.standards[0]?.text}</p><span class="stage-link">{en ? 'Explore progression' : '查看能力变迁'} <Icon name="arrow-right" size={16} /></span></a>)}</div>
  </section>
  <aside class="model-callout"><div><p class="eyebrow">{en ? 'Level mapping' : '职级映射参考'}</p><strong>{en ? 'External level maps are partial clues, not capability standards.' : '外部职级映射只能提供不完整的比较线索，不能当作能力标准。'}</strong></div><a class="button-link" href={pathFor({ type: 'capability-model-mapping' }, locale, base)}>{en ? 'Compare level mapping sources' : '查看职级映射参考'} <Icon name="arrow-right" size={16} /></a></aside>
</SiteLayout>
