---
import SiteLayout from '../layouts/SiteLayout.astro';
import { dimensionIds, getDimensionProgression, getStageProfile, stageIds, validateCapabilityModel } from '../lib/capability-model';
import { pathFor, type RouteRef } from '../lib/routes';
import type { Locale } from '../lib/taxonomy';
interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
const base = import.meta.env.BASE_URL;
const errors = validateCapabilityModel();
if (errors.length) throw new Error(`Invalid capability model: ${errors.join('; ')}`);
const stages = stageIds.map((id) => getStageProfile(id, locale));
const icStages = stages.filter((stage) => stage.track === 'ic');
const managementStages = stages.filter((stage) => stage.track !== 'ic');
const dimensions = dimensionIds.map((id) => getDimensionProgression(id, locale));
const route: RouteRef = { type: 'capability-model' };
---
<SiteLayout locale={locale} route={route} description={en ? 'An editorial capability heuristic for organizing interview questions.' : '用于组织面试问题的启发式能力模型草稿。'}>
  <section class="model-hero">
    <p class="eyebrow">{en ? 'INTERVIEW COMPASS EDITORIAL DRAFT' : 'INTERVIEW COMPASS · 启发式草稿'}</p>
    <h1 class="page-title">{en ? 'Build outcomes. Exercise judgment. Grow capability.' : '创造业务结果，建设判断力与人的竞争力'}</h1>
    <p class="intro">{en ? 'A working heuristic synthesized to organize this question library. It is not an externally validated standard or a substitute for your organization’s promotion rubric. AI expands execution capacity, while human judgment, ownership, and relationships shape how that capacity creates outcomes.' : '这是为组织本站题库而整理的通用启发式草稿，未经过外部标准验证，也不能替代所在组织的晋升能力模型。AI 扩大执行能力，而人的判断、责任和关系建设影响这些能力如何转化为结果。'}</p>
    <div class="model-principles"><span>{en ? 'Business outcomes' : '业务结果'}</span><span>{en ? 'Domain expertise' : '专业领域知识'}</span><span>{en ? 'Team influence' : '团队影响力'}</span><span>{en ? 'Human competitiveness' : '人的竞争力'}</span></div>
    <p class="model-note">{en ? 'AI capability is embedded across all four dimensions; it is not a separate maturity ladder.' : 'AI 能力贯穿四个维度，不单独形成一条工具熟练度阶梯。人的竞争力通过学习方式、思考质量、判断力与关系处理来观察。'}</p>
  </section>
  <section class="model-section" aria-labelledby="stage-heading">
    <div class="model-section-heading"><div><p class="eyebrow">{en ? 'Progression' : '阶段变迁'}</p><h2 id="stage-heading">{en ? 'Scope and leverage expand with each stage' : '阶段变化体现为责任范围与影响方式的扩展'}</h2></div><p>{en ? 'The IC and management paths branch from senior contribution.' : '高级工程师之后，资深工程师与工程管理者是不同发展路径；管理管理者通过多个管理者扩大组织结果。'}</p></div>
    <h3 class="track-heading">{en ? 'Individual contributor path' : '专业贡献路径'} <span>{en ? 'Junior → Mid-level → Senior → Staff' : '初级工程师 → 中级工程师 → 高级工程师 → 资深工程师'}</span></h3>
    <div class="stage-grid stage-grid-four">{icStages.map((stage) => <a class="stage-card" href={pathFor({ type: 'capability-model-stage', stage: stage.id }, locale, base)}><span class="stage-track">{en ? 'Individual contributor' : '专业贡献路径'}</span><strong>{stage.name}</strong><p>{stage.summary}</p><span class="stage-link">{en ? 'View standards →' : '查看阶段标准 →'}</span></a>)}</div>
    <h3 class="track-heading management-track-heading">{en ? 'Management path' : '管理路径'} <span>{en ? 'Branches from senior contribution' : '从高级专业贡献分流'}</span></h3>
    <div class="stage-grid management-stage-grid">{managementStages.map((stage) => <a class="stage-card" href={pathFor({ type: 'capability-model-stage', stage: stage.id }, locale, base)}><span class="stage-track">{stage.track === 'engineering-management' ? (en ? 'Engineering management' : '工程管理') : (en ? 'Organization leadership' : '组织管理')}</span><strong>{stage.name}</strong><p>{stage.summary}</p><span class="stage-link">{en ? 'View standards →' : '查看阶段标准 →'}</span></a>)}</div>
  </section>
  <section class="model-section" aria-labelledby="dimension-heading">
    <div class="model-section-heading"><div><p class="eyebrow">{en ? 'Capability map' : '能力地图'}</p><h2 id="dimension-heading">{en ? 'Four dimensions, connected to the A–H map' : '四个评价维度，连接站内 A–H 能力地图'}</h2></div><p>{en ? 'Each standard points back to the observable capability leaves it draws on.' : '维度描述阶段期待，A–H 能力叶子描述可发展的具体能力。每条标准都回连到相应能力叶子。'}</p></div>
    <div class="dimension-grid">{dimensions.map((dimension) => <a class="dimension-card" href={pathFor({ type: 'capability-model-dimension', dimension: dimension.id }, locale, base)}><span>{dimension.stages.reduce((sum, item) => sum + item.standards.length, 0)} {en ? 'stage standards' : '条阶段标准'}</span><strong>{dimension.name}</strong><p>{dimension.stages[0]?.standards[0]?.text}</p><span class="stage-link">{en ? 'Explore progression →' : '查看能力变迁 →'}</span></a>)}</div>
  </section>
  <aside class="model-callout"><div><p class="eyebrow">{en ? 'Level mapping' : '职级映射参考'}</p><strong>{en ? 'External level maps are partial clues, not capability standards.' : '外部职级映射只能提供不完整的比较线索，不能当作能力标准。'}</strong></div><a class="button-link" href={pathFor({ type: 'capability-model-mapping' }, locale, base)}>{en ? 'Compare level mapping sources' : '查看职级映射参考'} →</a></aside>
</SiteLayout>
