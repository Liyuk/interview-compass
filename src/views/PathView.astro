---
import SiteLayout from '../layouts/SiteLayout.astro';
import QuestionList from '../components/QuestionList.astro';
import { crossDomainPaths, domains, pick, type Locale } from '../lib/taxonomy';
import { getQuestions } from '../lib/question-catalog';
import { loadQuestions } from '../lib/site-data';

interface Props { locale: Locale; pathId: string }
const { locale, pathId } = Astro.props;
const en = locale === 'en';
const path = crossDomainPaths.find((item) => item.id === pathId)!;
const all = await loadQuestions(locale);
const sections = path.domains.map((domainId) => {
  const domain = domains.find((item) => item.id === domainId)!;
  return { domain, items: getQuestions(all, { locale, domain: domainId, topic: path.topic }) };
}).filter((section) => section.items.length > 0);
---
<SiteLayout locale={locale} route={{ type: 'path', id: path.id }} description={pick(path.description, locale)}>
  <p class="eyebrow">{en ? 'CROSS-DOMAIN PATH' : '跨域路径'}</p>
  <h1 class="page-title">{pick(path.name, locale)}</h1>
  <p class="intro">{pick(path.description, locale)}</p>
  <p class="intro">{en ? 'Each question below still belongs to one capability. The path only gathers them in reading order.' : '下面每道题仍然只属于一个能力，这条路径只是把它们按阅读顺序放在一起。'}</p>
  {sections.map(({ domain, items }, index) => (
    <section class="leaf-section">
      <h2>{index + 1}. {domain.letter} · {pick(domain.name, locale)}<span class="count">{items.length}</span></h2>
      <QuestionList questions={items} locale={locale} />
    </section>
  ))}
</SiteLayout>
