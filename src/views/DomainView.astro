---
import SiteLayout from '../layouts/SiteLayout.astro';
import TargetCount from '../components/TargetCount.astro';
import Icon from '../components/Icon.astro';
import QuestionList from '../components/QuestionList.astro';
import { domains, pick, type Locale } from '../lib/taxonomy';
import { pathFor } from '../lib/routes';
import { getQuestions } from '../lib/question-catalog';
import { loadQuestions } from '../lib/site-data';

interface Props { locale: Locale; domainId: string }
const { locale, domainId } = Astro.props;
const en = locale === 'en';
const base = import.meta.env.BASE_URL;
const domain = domains.find((item) => item.id === domainId)!;
const questions = await loadQuestions(locale);
const leaves = domain.leaves
  .map((leaf) => ({ leaf, items: getQuestions(questions, { locale, capability: `${domain.id}.${leaf.id}` }) }))
  .filter((entry) => entry.items.length > 0);
---
<SiteLayout locale={locale} route={{ type: 'domain', domain: domain.id }} description={pick(domain.description, locale)}>
  <p class="eyebrow">{en ? `DOMAIN ${domain.letter}` : `能力域 ${domain.letter}`}</p>
  <h1 class="page-title">{pick(domain.name, locale)}</h1>
  <p class="intro">{pick(domain.description, locale)}</p>
  <p class="model-inline-link">{en ? 'See how this domain develops across career stages.' : '查看这个能力域如何映射到阶段要求。'} <a href={pathFor({ type: 'capability-model' }, locale, base)}>{en ? 'View the career-stage model' : '打开能力模型'} <Icon name="arrow-right" size={16} /></a></p>
  <p class="reading-note">{en ? 'Choose a capability first. Each preview shows up to three questions; open it for focused batches.' : '先选一项能力。每类只预览三题，进入后按考察重点分批阅读；预览不代表重要性排名。'}</p>
  <p class="result-count"><TargetCount ids={leaves.flatMap(entry => entry.items.map(q => q.questionId))} locale={locale} unit /> · {leaves.length} {en ? 'capabilities' : '项能力'}</p>
  {leaves.map(({ leaf, items }) => (
    <section class="leaf-section">
      <h2><a href={pathFor({ type: 'leaf', domain: domain.id, leaf: leaf.id }, locale, base)}>{pick(leaf.name, locale)}</a><TargetCount class="count" questions={items} /></h2>
      <p class="band-text">{pick(leaf.description, locale)}</p>
      <QuestionList questions={items} limit={3} locale={locale} showCapability={false} />
      <a class="text-link" href={pathFor({ type: 'leaf', domain: domain.id, leaf: leaf.id }, locale, base)}>{en ? 'Browse by focus · ' : '按考察重点浏览 · '}<TargetCount questions={items} locale={locale} unit /> <Icon name="arrow-right" size={16} /></a>
    </section>
  ))}
</SiteLayout>
