---
import SiteLayout from '../layouts/SiteLayout.astro';
import SectionTranslations from '../components/docs/SectionTranslations.astro';
import * as zh from '../content/guide/zh-CN.md';
import * as en from '../content/guide/en.md';
import { guideHeadings, guideSectionsFor, type GuideDocument } from '../lib/guide-content';
import type { Locale } from '../lib/taxonomy';

interface Props { locale: Locale }
const { locale } = Astro.props;
const docs = { 'zh-CN': zh as unknown as GuideDocument, en: en as unknown as GuideDocument };
const doc = docs[locale];
const sections = guideSectionsFor(docs);
const headings = guideHeadings(doc, locale, sections);
const { title, description } = doc.frontmatter;
const Content = doc.Content as any;
---
<SiteLayout locale={locale} route={{ type: 'guide' }} description={description} outline={headings}>
  <SectionTranslations sections={sections} />
  <article class="guide-prose">
    <h1 class="page-title">{title}</h1>
    <Content />
  </article>
</SiteLayout>
<script>
  // Mark each rendered chapter with its stable section key so the shared outline can track it.
  const data = document.getElementById('article-section-translations');
  if (data) {
    const lang = document.documentElement.lang === 'en' ? 'en' : 'zh-CN';
    for (const section of JSON.parse(data.textContent ?? '[]') as { sectionKey: string; anchors: Record<string, string> }[]) {
      const id = section.anchors[lang];
      if (id) document.getElementById(id)?.setAttribute('data-section-key', section.sectionKey);
    }
  }
</script>
