---
import SectionTranslations from '../components/docs/SectionTranslations.astro';
import SectionHeading from '../components/docs/SectionHeading.astro';
import type { ArticleHeading } from '../lib/knowledge/outline';
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import { tokensForQuestion, engineeringLensForQuestion } from '../lib/question-profile-data';
import QuestionStageGuidance from '../components/QuestionStageGuidance.astro';
import { capabilityLabel, facetLabel, facetMeta, pick, splitCapability, type FacetKind, type Locale } from '../lib/taxonomy';
import { facetRoute, pathFor } from '../lib/routes';
import { facetValuesOf } from '../lib/question-catalog';
import { questionEvaluation } from '../lib/question-evaluation';
import { buildQuestionAnalysisPrompt } from '../lib/question-analysis-prompt';
import { searchKeywords } from '../lib/search-keywords';
import { loadAllRecords } from '../lib/site-data';
import { questionCollections } from '../lib/question-collections';

interface Props { locale: Locale; id: string }
const { locale, id } = Astro.props;
const en = locale === 'en';
const engineeringLens = engineeringLensForQuestion(id);
const base = import.meta.env.BASE_URL;
const all = await loadAllRecords();
const record = all.find((item) => item.questionId === id && item.locale === locale && item.status === 'published')!;
const evaluation = questionEvaluation(record);
const FrameworkTag = evaluation.specific ? 'div' : 'details';
const analysisPrompt = buildQuestionAnalysisPrompt({ locale, question: record, evaluation, engineeringContext: engineeringLens?.[en ? 'en' : 'zh'] });
const { domain, leaf } = splitCapability(record.primaryCapability);
const route = { type: 'question', questionId: record.questionId, capability: record.primaryCapability, title: record.question } as const;
const related = (record.relatedQuestions ?? []).flatMap((relation) => {
  const target = all.find((item) => item.questionId === relation.questionId && item.locale === locale && item.status === 'published');
  return target ? [{ ...relation, target }] : [];
});
const similarCoreQuestions = record.qualityTier === 'core' ? all
  .filter((item) => item.locale === locale && item.status === 'published' && item.qualityTier === 'core' && item.questionId !== record.questionId)
  .map((item) => ({
    item,
    score: (item.primaryCapability === record.primaryCapability ? 5 : 0)
      + item.topics.filter((topic) => record.topics.includes(topic)).length * 2
      + item.scenarios.filter((scenario) => record.scenarios.includes(scenario)).length,
  }))
  .filter(({ score }) => score > 0)
  .sort((a, b) => b.score - a.score || a.item.questionId.localeCompare(b.item.questionId))
  .slice(0, 3)
  .map(({ item }) => item) : [];
const nextCoreQuestion = similarCoreQuestions[0] ?? all.find((item) => item.locale === locale && item.status === 'published' && item.qualityTier === 'core' && item.questionId !== record.questionId);
const containingQuestionSets = record.qualityTier === 'core' ? questionCollections.filter((collection) =>
  collection.kind === 'question-set' && collection.entries.some((entry) => entry.questionId === record.questionId)) : [];
const hasCoreContinuation = record.qualityTier === 'core';
const showObjectiveSection = record.qualityTier !== 'core' || evaluation.specific;
const perspectiveGuide = record.qualityTier === 'core' ? {
  title: record.perspective === 'candidate'
    ? (en ? 'Review your answer against evidence anchors' : '用证据锚点复核自己的回答')
    : record.perspective === 'interviewer'
      ? (en ? 'Probe for evidence consistently' : '围绕证据进行一致追问')
      : (en ? 'Gather evidence for feedback and responsibility' : '为反馈和责任判断收集证据'),
  note: record.perspective === 'candidate'
    ? (en ? 'Use these anchors to check what you can support with evidence. They guide reflection; they are not an automatic score.' : '检查哪些内容能由证据支持。锚点用于复盘，不会自动给回答打分。')
    : record.perspective === 'interviewer'
      ? (en ? 'Ask the same evidence-focused follow-ups across candidates and relate observations to the role.' : '对不同候选人使用一致的证据追问，并把观察与岗位要求对应。')
      : (en ? 'Connect observed evidence to the responsibility actually delegated, then give specific feedback and a next step.' : '把观察到的证据对应到实际授权的责任，再给出具体反馈和下一步。'),
  items: record.perspective === 'candidate'
    ? [
        ...(record.anchors ? [
          `${en ? 'Not passing' : '不通过'} · ${record.anchors.notPassing}`,
          `${en ? 'Passing' : '通过'} · ${record.anchors.passing}`,
          `${en ? 'Excellent' : '优秀'} · ${record.anchors.excellent}`,
          `${en ? 'Exceptional' : '卓越'} · ${record.anchors.exceptional}`,
        ] : []),
      ]
    : record.perspective === 'interviewer'
      ? [
          ...(record.followUps ?? []).map((item) => `${en ? 'Follow-up' : '追问'} · ${item}`),
          ...(record.anchors ? [
            `${en ? 'Not passing' : '不通过'} · ${record.anchors.notPassing}`,
            `${en ? 'Passing' : '通过'} · ${record.anchors.passing}`,
            `${en ? 'Excellent' : '优秀'} · ${record.anchors.excellent}`,
            `${en ? 'Exceptional' : '卓越'} · ${record.anchors.exceptional}`,
          ] : []),
        ]
      : record.signals,
} : undefined;
const chapters = [
  ...(showObjectiveSection ? [{ id: 'objective-h', label: evaluation.objectiveTitle }] : []),
  ...(perspectiveGuide ? [{ id: 'perspective-guide-h', label: perspectiveGuide.title }] : []),
  { id: 'intent-h', label: evaluation.intentTitle },
  { id: 'signals-h', label: en ? 'Signals worth noticing' : '值得观察的信号' },
  { id: 'context-h', label: evaluation.contextTitle },
  { id: 'inference-h', label: evaluation.inferenceTitle },
  ...(evaluation.comparisons.length > 0 ? [{ id: 'comparisons-h', label: evaluation.comparisonsTitle }] : []),
  { id: 'decision-h', label: evaluation.decisionTitle },
  { id: 'tradeoffs-h', label: en ? 'Examine the trade-offs' : '分析方案的利与弊' },
  { id: 'assessment-h', label: evaluation.title },
  ...(evaluation.highlightEvidence.length > 0 ? [{ id: 'highlight-evidence-h', label: en ? 'Evidence that could make a contribution visible' : '可以体现贡献的证据' }] : []),
  ...(record.background?.length ? [{ id: 'background-h', label: en ? 'Background to review' : '背景知识' }] : []),
  ...(related.length > 0 ? [{ id: 'related-h', label: en ? 'Related questions' : '相近的问题' }] : []),
  ...(hasCoreContinuation ? [{ id: 'core-continuation-h', label: en ? 'Continue with related core questions' : '沿相关核心题继续阅读' }] : []),
];
const outline: ArticleHeading[] = chapters.flatMap(chapter => [
  { ...chapter, sectionKey: chapter.id, level: 2 as const },
  ...(chapter.id === 'tradeoffs-h' ? [
    { id: 'benefits-h', sectionKey: 'benefits-h', label: evaluation.benefitsTitle, level: 3 as const },
    { id: 'costs-h', sectionKey: 'costs-h', label: evaluation.costsTitle, level: 3 as const },
  ] : []),
]);
const headingFor = (id: string) => outline.find(item => item.id === id)!;
const contextKinds: FacetKind[] = ['roles', 'scenarios', 'topics', 'responsibilityScopes', 'careerTracks', 'formats'];
const context = contextKinds.map((kind) => ({ kind, ids: facetValuesOf(record, kind) })).filter((group) => group.ids.length > 0);
const keywords = searchKeywords(record, locale);
const provenanceLabel = { adapted: en ? 'Adapted from' : '改编自', derived: en ? 'Derived from' : '提炼自', inspired: en ? 'Inspired by' : '启发自', original: en ? 'Original to this site' : '本站原创' };
---
<SiteLayout locale={locale} route={route} description={record.intent} outline={outline}>
  <SectionTranslations sections={outline.map(item => ({ sectionKey: item.sectionKey, anchors: { 'zh-CN': item.id, en: item.id } }))} />
  <a class="reading-return" data-reading-return href={pathFor({ type: 'questions' }, locale, base)}><Icon name="arrow-left" size={16} /> {en ? 'Back to your results or question set' : '返回本次结果或题单'}</a>
  <h1 class="page-title" data-pagefind-meta="title" data-pagefind-body data-pagefind-weight="10">{record.question}</h1>
  {tokensForQuestion(record.questionId).map(token => <span hidden data-pagefind-filter="profile[data-profile-token]" data-profile-token={token} />)}
  <aside class="target-mismatch" data-question-detail-profiles={tokensForQuestion(record.questionId).join(' ')} hidden data-pagefind-ignore><p>{en ? 'This question is outside your current target. The direct link stays readable.' : '此题不在当前目标范围内，直接链接仍可完整阅读。'}</p><button type="button" data-edit-target>{en ? 'Change target' : '切换目标'}</button><button type="button" data-view-all-target>{en ? 'View all questions' : '查看全部题目'}</button></aside>
  {engineeringLens && <aside class="engineering-context" data-engineering-context data-pagefind-ignore><strong>{en ? 'Engineering business context' : '工程师的业务理解视角'}</strong><p>{engineeringLens[en ? 'en' : 'zh']}</p></aside>}
  <div data-pagefind-body>
    <p class="sr-only">{keywords.join(' ')}</p>
    <meta data-pagefind-filter={`capability:${record.primaryCapability}`} />
    <meta data-pagefind-filter={`domain:${record.primaryCapability.split('.')[0]}`} />
    {record.responsibilityScopes.map(facetId => <meta data-pagefind-filter={`scope:${facetId}`} />)}
    {record.careerTracks.map(facetId => <meta data-pagefind-filter={`track:${facetId}`} />)}
    {(record.formats ?? []).map(facetId => <meta data-pagefind-filter={`format:${facetId}`} />)}
    {record.scenarios.map((facetId) => <meta data-pagefind-filter={`scenario:${facetId}`} />)}
    {record.topics.map((facetId) => <meta data-pagefind-filter={`topic:${facetId}`} />)}
    {record.roles.map((facetId) => <meta data-pagefind-filter={`role:${facetId}`} />)}
    {showObjectiveSection && <section class="detail-block" aria-labelledby="objective-h">
      <details class={`analysis-review-status ${evaluation.specific ? 'is-reviewed' : 'is-shared'}`}><summary>{evaluation.reviewLabel}</summary><p>{evaluation.reviewNote}</p></details>
      <SectionHeading heading={headingFor('objective-h')} />
      <p class="intent-callout">{evaluation.objective}</p>
    </section>}

    {perspectiveGuide && <section class="core-perspective-guide" aria-labelledby="perspective-guide-h" data-perspective-guide={record.perspective}>
      <div><p class="eyebrow">{en ? 'REVIEWED CORE QUESTION' : '逐题复核核心题'}</p><SectionHeading heading={headingFor('perspective-guide-h')} /><p class="core-perspective-note">{perspectiveGuide.note}</p></div>
      <ul class="signal-list" data-perspective-evidence>{perspectiveGuide.items.map((item) => <li>{item}</li>)}</ul>
      {record.weakAnswer && <p class="core-weak-answer"><strong>{en ? 'Weak evidence to watch for' : '需要留意的薄弱回答'}</strong> {record.weakAnswer}</p>}
      {record.perspective === 'manager' && <div class="manager-feedback-guide" data-manager-feedback><strong>{en ? 'Turn observations into feedback' : '把观察转成反馈'}</strong><ol><li>{en ? 'Name the observed action and evidence.' : '指出观察到的行动和具体证据。'}</li><li>{en ? 'Connect it to the responsibility and impact.' : '对应到承担的责任和产生的影响。'}</li><li>{en ? 'Agree on a clear next step.' : '共同明确下一步行动。'}</li></ol></div>}
    </section>}

    <section class="detail-block" aria-labelledby="intent-h" id={!showObjectiveSection ? 'objective-h' : undefined}>
      <SectionHeading heading={headingFor('intent-h')} />
      <p>{evaluation.intent}</p>
    </section>

    <section class="detail-block" aria-labelledby="signals-h">
      <SectionHeading heading={headingFor('signals-h')} />
      <ul class="signal-list">{record.signals.map((signal) => <li>{signal}</li>)}</ul>
    </section>

    <section class="detail-block" aria-labelledby="context-h">
      <SectionHeading heading={headingFor('context-h')} />
      <ul class="signal-list">{evaluation.contextQuestions.map((item) => <li>{item}</li>)}</ul>
    </section>

    <FrameworkTag data-pagefind-ignore={!evaluation.specific ? 'all' : undefined} class:list={{'shared-question-framework': !evaluation.specific}}>
      {!evaluation.specific && <summary>{en ? 'Shared analysis and assessment prompts' : '查看共用的分析与评估提示'}</summary>}
    <section class="detail-block" aria-labelledby="inference-h">
      <SectionHeading heading={headingFor('inference-h')} />
      <p>{evaluation.inference}</p>
    </section>

    {evaluation.comparisons.length > 0 && <section class="detail-block" aria-labelledby="comparisons-h">
      <SectionHeading heading={headingFor('comparisons-h')} />
      <div class="comparison-prompt-grid">{evaluation.comparisons.map((item) => <article><h3>{item.dimension}</h3><p>{item.guidance}</p></article>)}</div>
    </section>}

    <section class="analysis-grid" aria-label={evaluation.decisionTitle}>
      <article class="analysis-card decision-card">
        <SectionHeading heading={headingFor('decision-h')} />
        <p>{evaluation.decision}</p>
      </article>
      <article class="analysis-card tradeoff-card">
        <SectionHeading heading={headingFor('tradeoffs-h')} />
        <div class="tradeoff-columns">
          <section aria-labelledby="benefits-h">
            <SectionHeading heading={headingFor('benefits-h')} />
            <ul class="signal-list">{evaluation.benefits.map((item) => <li>{item}</li>)}</ul>
          </section>
          <section aria-labelledby="costs-h">
            <SectionHeading heading={headingFor('costs-h')} />
            <ul class="signal-list">{evaluation.costs.map((item) => <li>{item}</li>)}</ul>
          </section>
        </div>
      </article>
    </section>

    <section class="detail-block assessment-block" aria-labelledby="assessment-h">
      <div class="assessment-heading">
        <div>
          <SectionHeading heading={headingFor('assessment-h')} />
          <p>{evaluation.note}</p>
        </div>
      </div>
      <div class="assessment-grid">
        {evaluation.levels.map((level) => (
          <article class={`assessment-level assessment-${level.id}`}>
            <h3>{level.label}</h3>
            <p>{level.meaning}</p>
            <p class="assessment-reference">{level.reference}</p>
          </article>
        ))}
      </div>
    </section>

    {evaluation.highlightEvidence.length > 0 && <section class="detail-block" aria-labelledby="highlight-evidence-h">
      <SectionHeading heading={headingFor('highlight-evidence-h')} />
      <ul class="signal-list">{evaluation.highlightEvidence.map((item) => <li>{item}</li>)}</ul>
    </section>}

    </FrameworkTag>

    {record.background?.length ? (
      <section class="detail-block" aria-labelledby="background-h">
        <SectionHeading heading={headingFor('background-h')} />
        <ul class="signal-list">{record.background.map((item) => <li>{item}</li>)}</ul>
      </section>
    ) : null}

  </div>

  <details class="question-relevance" data-pagefind-ignore>
    <summary>{en ? 'Question context and related views' : '适用范围与相关索引'}</summary>
  <div class="question-fit" aria-label={en ? 'Question relevance' : '适用范围'}>
    {context.filter((group) => ['roles', 'responsibilityScopes', 'careerTracks'].includes(group.kind)).map((group) => <p><strong>{pick(facetMeta[group.kind].name, locale)}</strong><span>{group.ids.map((id) => facetLabel(group.kind, id, locale)).join(en ? ' · ' : '、')}</span></p>)}
    <p class="band-text">{en ? 'Select questions for the responsibility you actually hold or seek. These labels are not universal stage requirements.' : '按目标岗位和实际责任选题；这些标签不表示所有阶段都必须掌握。'} <a href={pathFor({ type: 'capability-model' }, locale, base)}>{en ? 'Stage expectations' : '查看阶段要求'}</a></p>
  </div>
  <nav class="question-context-nav" aria-label={en ? 'Explore related views' : '按相关维度继续查找'}>
    <span>{en ? 'Explore this question through:' : '按相关维度继续查找：'}</span>
    {context.filter((group) => ['topics', 'scenarios'].includes(group.kind)).flatMap((group) => group.ids.map((facetId) => {
      const target = facetRoute(group.kind, facetId);
      return target ? <a href={pathFor(target, locale, base)}>{facetLabel(group.kind, facetId, locale)}</a> : null;
    }))}
    <a href={pathFor({ type: 'leaf', domain: domain!.id, leaf: leaf!.id }, locale, base)}>{en ? 'More in this capability' : '同类能力问题'}</a>
  </nav>
  </details>
  <noscript><style>.question-analysis-prompt{display:none!important}</style></noscript>
  <QuestionStageGuidance question={record} locale={locale} />
  <section class="question-analysis-prompt" aria-label={en ? 'Optional external AI analysis' : '可选的外部 AI 分析'}>
    <p>{en ? 'Want deeper feedback? Generate a prompt with this question’s evidence framework, then choose an AI tool yourself.' : '需要进一步分析时，可以生成包含本题证据框架的 Prompt，再自行选择 AI 工具使用。本站不会发送你的回答。'}</p>
    <button class="button-link" type="button" data-generate-analysis>{en ? 'Generate AI analysis prompt' : '生成 AI 分析 Prompt'} <Icon name="arrow-up-right" size={16} /></button>
    <div id="question-analysis-prompt-panel" data-analysis-panel data-pagefind-ignore hidden>
      <label for="question-ai-prompt">{en ? 'AI analysis prompt' : 'AI 分析 Prompt'}</label>
      <textarea id="question-ai-prompt" readonly rows="18">{analysisPrompt}</textarea>
      <div class="question-analysis-prompt-actions">
        <button type="button" class="secondary-button" data-copy-analysis>{en ? 'Copy prompt' : '复制 Prompt'}</button>
        <span role="status" aria-live="polite" data-copy-status></span>
      </div>
    </div>
  </section>

    {related.length > 0 && (
      <section class="detail-block" aria-labelledby="related-h" data-related-section>
        <SectionHeading heading={headingFor('related-h')} />
        <table class="comparison">
          <thead><tr><th>{en ? 'Question' : '问题'}</th><th>{en ? 'Relation' : '关系'}</th><th>{en ? 'What changes' : '观察差异'}</th></tr></thead>
          <tbody>
            {related.map(({ target, relation, contrast }) => (
              <tr data-question-profiles={tokensForQuestion(target.questionId).join(' ')}>
                <td><a href={pathFor({ type: 'question', questionId: target.questionId, capability: target.primaryCapability, title: target.question }, locale, base)}>{target.question}</a></td>
                <td>{relation}</td>
                <td>{contrast}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )}
  <section class="metadata-grid" aria-label={en ? 'Question context' : '问题的上下文'}>
    <div class="metadata-block">
      <h2>{en ? 'Primary capability' : '主要能力'}</h2>
      <p>
        {domain && leaf
          ? <a href={pathFor({ type: 'leaf', domain: domain.id, leaf: leaf.id }, locale, base)}>{capabilityLabel(record.primaryCapability, locale)}</a>
          : capabilityLabel(record.primaryCapability, locale)}
      </p>
    </div>
    {context.map((group) => (
      <div class="metadata-block">
        <h2>{pick(facetMeta[group.kind].name, locale)}</h2>
        <p class="pill-row">
          {group.ids.map((facetId) => {
            const target = facetRoute(group.kind, facetId);
            return target
              ? <a href={pathFor(target, locale, base)}>{facetLabel(group.kind, facetId, locale)}</a>
              : <span>{facetLabel(group.kind, facetId, locale)}</span>;
          })}
        </p>
      </div>
    ))}
    <div class="metadata-block">
      <h2>{en ? 'Source' : '来源'}</h2>
      <ul>
        {record.source.map((item) => (
          <li>
            {item.url
              ? <>{provenanceLabel[item.attribution]}：<a href={item.url} rel="noreferrer">{item.label ?? item.url}</a></>
              : (item.label ?? provenanceLabel[item.attribution])}
          </li>
        ))}
      </ul>
    </div>
  </section>
  {hasCoreContinuation && <section class="core-continuation" aria-labelledby="core-continuation-h" data-core-continuation>
    <SectionHeading heading={headingFor('core-continuation-h')} />
    {nextCoreQuestion && <p class="core-next-question"><a data-core-next href={pathFor({ type: 'question', questionId: nextCoreQuestion.questionId, capability: nextCoreQuestion.primaryCapability, title: nextCoreQuestion.question }, locale, base)}>{en ? 'Continue to the next reviewed question' : '继续阅读下一道已复核核心题'} <Icon name="arrow-right" size={16} /></a></p>}
    <div class="core-continuation-groups">
      {similarCoreQuestions.length > 0 && <div><h3>{en ? 'Similar reviewed questions' : '相近的已复核问题'}</h3><ul>{similarCoreQuestions.map((item) => <li><a data-similar-core href={pathFor({ type: 'question', questionId: item.questionId, capability: item.primaryCapability, title: item.question }, locale, base)}>{item.question}</a></li>)}</ul></div>}
      {containingQuestionSets.length > 0 && <div><h3>{en ? 'Curated sets containing this question' : '包含这道题的精选题单'}</h3><ul>{containingQuestionSets.map((collection) => <li><a data-containing-set href={pathFor({ type: 'collection', id: collection.id }, locale, base)}>{pick(collection.title, locale)}</a><span> · {pick(collection.purpose, locale)}</span></li>)}</ul></div>}
      {containingQuestionSets.length === 0 && <div><h3>{en ? 'Browse curated paths' : '浏览精选题单'}</h3><ul><li><a data-curated-sets href={pathFor({ type: 'collections' }, locale, base)}>{en ? 'Explore curated question sets' : '查看全部精选题单'}</a></li></ul></div>}
    </div>
  </section>}
  <aside class="journey-next"><h2>{en ? 'Where next?' : '接下来怎么用？'}</h2><p>{en ? 'Return to your chosen set, compare related questions, or choose a different goal.' : '回到选定的题单或结果继续阅读，也可以换一个目标重新选题。'}</p><div class="journey-links"><a data-reading-return href={pathFor({ type: 'questions' }, locale, base)}>{en ? 'Back to your results or question set' : '返回本次结果或题单'}</a><a href={pathFor({ type: 'collections' }, locale, base)}>{en ? 'Curated sets' : '精选题单'}</a><a href={pathFor({ type: 'scenarios' }, locale, base)}>{en ? 'Choose a goal' : '目标路径'}</a><a href={pathFor({ type: 'leaf', domain: domain!.id, leaf: leaf!.id }, locale, base)}>{en ? 'More in this capability' : '同类能力问题'}</a></div></aside>
</SiteLayout>

<script>
  import '../lib/question-analysis-panel';
</script>
