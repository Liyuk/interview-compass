---
import { loadKnowledgeRegistry } from '../lib/knowledge/site-registry';
import Icon from '../components/Icon.astro';
import { tokensForQuestion } from '../lib/question-profile-data';
import SiteLayout from '../layouts/SiteLayout.astro';
import { domains, audienceRoles, facetDefinitions, facetKinds, facetMeta, pick, type FacetKind, type Locale } from '../lib/taxonomy';
import { facetCounts } from '../lib/question-catalog';
import { capabilityLabel } from '../lib/taxonomy';
import { pathFor } from '../lib/routes';
import { CATALOG_PAGE_SIZE } from '../lib/search-pagination';
import { loadQuestions } from '../lib/site-data';

interface Props { locale: Locale; routeType?: 'questions' | 'search' }
const { locale, routeType = 'questions' } = Astro.props;
const en = locale === 'en';
const base = import.meta.env.BASE_URL;
const questions = await loadQuestions(locale);
const filterKinds = facetKinds;
const primaryFilterKinds: FacetKind[] = ['roles', 'scenarios', 'responsibilityScopes', 'careerTracks'];
const advancedFilterKinds: FacetKind[] = ['topics', 'formats'];
const queryKey: Record<FacetKind, string> = { topics: 'topic', roles: 'role', responsibilityScopes: 'scope', careerTracks: 'track', scenarios: 'scenario', formats: 'format' };
const capabilityOptions = domains.flatMap((domain) => domain.leaves.map((leaf) => ({ id: `${domain.id}.${leaf.id}`, label: `${domain.letter} · ${pick(leaf.name, locale)}`, count: questions.filter((q) => q.primaryCapability === `${domain.id}.${leaf.id}`).length }))).filter((option) => option.count > 0);
const capabilityLabels = Object.fromEntries(capabilityOptions.map(option => [option.id, capabilityLabel(option.id, locale)]));
const documents = (await loadKnowledgeRegistry()).pages(locale).filter(node => ['guide','method','concept','path','stage-reference'].includes(node.kind)).map(node=>({id:node.contentId,kind:'docs',title:node.title,url:node.href}));
const firstPage = questions.slice(0, CATALOG_PAGE_SIZE);
const facetOptions = filterKinds.map((kind) => {
  const counts = facetCounts(questions, { locale, facet: kind });
  return { kind, options: (kind === 'roles' ? audienceRoles : facetDefinitions[kind]).filter((entry) => counts.has(entry.id)).map((entry) => ({ id: entry.id, label: pick(entry.name, locale), count: counts.get(entry.id) ?? 0 })) };
}).filter((group) => group.options.length > 0);
---
<SiteLayout locale={locale} route={{ type: routeType }} description={en ? 'Browse and filter every published question.' : '浏览并筛选所有已发布的问题。'}>
  <nav class="library-mode-switch" aria-label={en ? 'Question library modes' : '题库入口'}>
    <a href={pathFor({ type: 'collections' }, locale, base)}>{en ? 'Curated sets' : '精选题单'}</a>
    <a href={pathFor({ type: 'questions' }, locale, base)} aria-current="page">{en ? 'Full library' : '全量题库'}</a>
  </nav>
  <h1 class="page-title">{routeType === 'search' ? (en ? 'Search results' : '搜索结果') : (en ? 'Question library' : '面试题库')}</h1>
  <p class="intro">{en ? 'Search documents and methods, or filter questions. Preparation targets and page filters apply to questions. The address bar keeps your view for sharing.' : '搜索文档与方法，或按条件选题。准备目标与题目筛选只作用于题目；地址栏保留当前视图，方便分享。'}</p>

  <form data-target-content class="question-filters" id="filters" aria-label={en ? 'Filter questions' : '筛选问题'}>
    <div class="filters discovery-query">
      <label><span>{en ? 'Keywords' : '关键词'}</span><input type="search" name="q" aria-label={en ? 'Discovery keywords' : '检索关键词'} /></label>
      <label><span>{en ? 'Content' : '内容类型'}</span><select name="searchScope"><option value="all">{en ? 'All content' : '全部内容'}</option><option value="docs">{en ? 'Documents and methods' : '文档与方法'}</option><option value="questions">{en ? 'Questions' : '题目'}</option></select></label>
      <label><span>{en ? 'Order' : '排序'}</span><select name="sort"><option value="relevance">{en ? 'Recommended order' : '推荐顺序'}</option><option value="title">{en ? 'Title' : '标题'}</option></select></label>
      <button type="submit">{en ? 'Find' : '查找'}</button>
    </div>
    <details open class="discovery-facet-disclosure" data-discovery-facets>
      <summary>{en ? 'Filter questions' : '筛选题目'}</summary>
    <div class="filters filters-primary">
    {facetOptions.filter((group) => primaryFilterKinds.includes(group.kind)).map((group) => (
      <label>
        <span>{pick(facetMeta[group.kind].name, locale)}</span>
        <span class="select-control"><select name={queryKey[group.kind]}><option value="">{en ? 'Any' : '全部'}</option>{group.options.map((o) => <option value={o.id} data-count-label={o.label} data-total-count={o.count}>{o.label} ({o.count})</option>)}</select><Icon name="chevron-down" size={16} /></span>
      </label>
    ))}
    </div>
    <details class="advanced-filter-disclosure" id="advanced-filters">
      <summary><Icon name="chevron-right" size={16} /><span>{en ? 'More filters' : '更多筛选'}</span><span id="advanced-filter-count" class="advanced-filter-count"></span></summary>
      <div class="filters filters-advanced">
        <label>
          <span>{en ? 'Capability' : '能力'}</span>
          <span class="select-control"><select name="capability"><option value="">{en ? 'Any' : '全部'}</option>{capabilityOptions.map((o) => <option value={o.id} data-count-label={o.label} data-total-count={o.count}>{o.label} ({o.count})</option>)}</select><Icon name="chevron-down" size={16} /></span>
        </label>
        {facetOptions.filter((group) => advancedFilterKinds.includes(group.kind)).map((group) => (
          <label>
            <span>{pick(facetMeta[group.kind].name, locale)}</span>
            <span class="select-control"><select name={queryKey[group.kind]}><option value="">{en ? 'Any' : '全部'}</option>{group.options.map((o) => <option value={o.id} data-count-label={o.label} data-total-count={o.count}>{o.label} ({o.count})</option>)}</select><Icon name="chevron-down" size={16} /></span>
          </label>
        ))}
      </div>
    </details>
    </details>
    <script is:inline>{ const d = document.currentScript?.previousElementSibling; if (d?.matches('[data-discovery-facets]') && matchMedia('(max-width:760px)').matches) d.open = false; }</script>
    <button type="button" id="clear-filters">{en ? 'Clear filters' : '清除筛选'}</button>
  </form>
  <details class="filter-help">
    <summary class="disclosure-summary"><Icon name="chevron-right" size={16} />{en ? 'What do these filters mean?' : '这些筛选项是什么意思？'}</summary>
    <dl>
      <dt>{en ? 'Capability' : '能力'}</dt><dd>{en ? 'The one thing a question is mainly meant to examine. Each question has exactly one.' : '一道题主要想考察的那一件事。每道题只有一个。'}</dd>
      {facetOptions.map((group) => <><dt>{pick(facetMeta[group.kind].name, locale)}</dt><dd>{pick(facetMeta[group.kind].description, locale)}</dd></>)}
    </dl>
  </details>

  <div id="selected-filters" class="selected-filters" aria-label={en ? 'Selected filters' : '已选条件'}></div>
  <div class="share-filter-controls"><button type="button" class="secondary-button" id="share-filter-link">{en ? 'Copy filtered link' : '复制筛选链接'}</button><span id="share-filter-status" role="status" aria-live="polite"></span><input id="share-filter-value" readonly hidden aria-label={en ? 'Shareable filtered URL' : '可分享的筛选链接'} /></div>
  <script type="application/json" id="library-capability-labels" set:html={JSON.stringify(capabilityLabels).replace(/</g, '\\u003c')} />
  <script type="application/json" id="discovery-documents" set:html={JSON.stringify(documents).replaceAll('<', '\u003c')} />
  <section aria-label={en ? 'Documents and methods' : '文档与方法'} id="discovery-docs" hidden data-pagefind-ignore><h2>{en ? 'Documents and methods' : '文档与方法'} <span data-docs-count></span></h2><ul class="question-list" id="document-results"></ul><a data-discovery-group="docs" hidden></a></section>
  <h2 id="discovery-questions-heading">{en ? 'Questions' : '题目'}</h2>
  <p data-target-content id={routeType === 'search' ? 'search-page-status' : 'result-count'} class="result-count" role="status" aria-live="polite">{en ? `${questions.length} questions` : `${questions.length} 道问题`}</p>
  <ul class="question-list search-page-results" id={routeType === 'search' ? 'search-page-results' : 'question-list'} data-discovery-results data-library-pending>
    {firstPage.map((q) => (
      <li
        data-question-id={q.questionId}
        data-question-profiles={tokensForQuestion(q.questionId).join(' ')}
        data-capability={q.primaryCapability}
        data-topic={q.topics.join(' ')}
        data-role={q.roles.join(' ')}
        data-scope={q.responsibilityScopes.join(' ')}
        data-track={q.careerTracks.join(' ')}
        data-scenario={q.scenarios.join(' ')}
        data-format={(q.formats ?? []).join(' ')}
      >
        <a href={pathFor({ type: 'question', questionId: q.questionId, capability: q.primaryCapability, title: q.title }, locale, base)}>
          <span class="question-text">{q.question}</span>
          <span class="question-meta">{capabilityLabel(q.primaryCapability, locale)}</span>
        </a>
      </li>
    ))}
  </ul>
  <a data-discovery-group="questions" hidden></a>
  <noscript><style>.question-filters,.share-filter-controls,.selected-filters{display:none!important}</style><p>{en ? `This page lists the first ${firstPage.length} questions. Enable JavaScript to filter and page the full library.` : `本页列出前 ${firstPage.length} 题。启用 JavaScript 后可筛选并翻页浏览全部题目。`}</p></noscript>
  <nav class="library-pagination" id="library-pagination" aria-label={en ? 'Question pages' : '问题分页'} hidden>
    <button type="button" id="previous-page">{en ? 'Previous page' : '上一页'}</button>
    <span id="page-status" role="status"></span>
    <button type="button" id="next-page">{en ? 'Next page' : '下一页'}</button>
  </nav>
  <div id="no-results" class="empty-state target-empty" hidden><p data-library-empty-message>{en ? 'No question matches every filter.' : '没有题目同时满足所有条件。'}</p><button type="button" data-clear-page-filters>{en ? 'Clear page filters' : '清除页面条件'}</button> · <button type="button" data-view-all-target>{en ? 'View all questions' : '查看全部题目'}</button></div>

  <div id="discovery-error" hidden role="status"><p data-error-message></p><button type="button" data-discovery-retry>{en ? 'Retry' : '重试'}</button></div>
  <script>import '../lib/discovery/controller';</script>
</SiteLayout>
