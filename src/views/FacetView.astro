---
import Icon from '../components/Icon.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import TargetCount from '../components/TargetCount.astro';
import QuestionList from '../components/QuestionList.astro';
import { domains, facetLabel, pick, type Locale } from '../lib/taxonomy';
import { getQuestions } from '../lib/question-catalog';
import { loadQuestions } from '../lib/site-data';
import { pathFor } from '../lib/routes';
import { questionCollections } from '../lib/question-collections';
import { CATALOG_PAGE_SIZE, getPageWindow } from '../lib/search-pagination';

type Kind = 'roles' | 'scenarios' | 'topics';
interface Props { locale: Locale; kind: Kind; id: string; page?: number }
const { locale, kind, id, page: requestedPage = 1 } = Astro.props;
const en = locale === 'en';
const base = import.meta.env.BASE_URL;
const filterKey = { roles: 'role', scenarios: 'scenario', topics: 'topic' }[kind] as 'role' | 'scenario' | 'topic';
const questions = getQuestions(await loadQuestions(locale), { locale, [filterKey]: id });
const coreQuestions = kind === 'scenarios' ? questions.filter((q) => q.qualityTier === 'core') : [];
const corePreviewQuestions = coreQuestions.slice(0, 6);
const remainingCoreQuestions = coreQuestions.slice(corePreviewQuestions.length);
const relevantCoreSets = kind === 'scenarios' ? questionCollections
  .filter((collection) => collection.kind === 'question-set')
  .map((collection) => ({ collection, matches: collection.entries.filter((entry) => coreQuestions.some((question) => question.questionId === entry.questionId)).length }))
  .filter(({ matches }) => matches > 0)
  .sort((a, b) => b.matches - a.matches || a.collection.id.localeCompare(b.collection.id))
  .slice(0, 2) : [];
const extendedQuestions = kind === 'scenarios' ? questions.filter((q) => q.qualityTier !== 'core') : questions;
const pageWindow = getPageWindow(extendedQuestions.length, requestedPage, CATALOG_PAGE_SIZE);
const pageQuestions = extendedQuestions.slice(pageWindow.start, pageWindow.end);
const route = ({ roles: { type: 'role', id }, scenarios: { type: 'scenario', id }, topics: { type: 'topic', id } } as const)[kind];
const label = facetLabel(kind, id, locale);
const intro = kind === 'scenarios'
  ? (en ? 'Start with reviewed core questions. The extended library remains available below for broader exploration.' : '先从逐题复核的核心题开始；下方仍保留扩展题库，供进一步浏览。')
  : (en ? 'These are the same questions found in the library, grouped here by the capability each one mainly examines.' : '这些题与问题库里的是同一批，这里按各自主要考察的能力分组。');
const groups = domains
  .map((domain) => ({ domain, items: pageQuestions.filter((q) => q.primaryCapability.startsWith(`${domain.id}.`)) }))
  .filter((group) => group.items.length > 0);
const eyebrow = { roles: en ? 'ROLE' : '岗位', scenarios: en ? 'USE CASE' : '使用场景', topics: en ? 'TOPIC' : '主题' }[kind];
const promotionLanes = [
  {
    id: 'individual-contributor',
    title: en ? 'Individual-contributor promotion' : '专业贡献者晋升',
    scope: en ? 'Build a case around deeper craft, wider ownership, and impact beyond your own tasks.' : '围绕专业深度、责任范围扩大，以及超出个人任务的影响来整理证据。',
  },
  {
    id: 'team-manager',
    title: en ? 'Transition to or growth as a first-line manager' : '转向或发展为一线管理者',
    scope: en ? 'Show how results increasingly come through team design, coaching, delegation, and operating mechanisms.' : '说明结果如何逐渐通过团队设计、辅导、授权和运行机制产生。',
  },
  {
    id: 'senior-manager',
    title: en ? 'Multi-team engineering leadership' : '管理管理者',
    scope: en ? 'Show durable outcomes through leaders, cross-team decisions, succession, and organizational health.' : '说明如何通过负责人取得持续结果，并处理跨团队决策、继任和组织健康。',
  },
];
const promotionQuestionPath = `${pathFor({ type: 'questions' }, locale, base)}?scenario=promotion&track=`;
const promotionDialoguePath = pathFor({ type: 'collection', id: 'promotion-dialogue' }, locale, base);
const listPath = pathFor(route, locale, base);
const pageHref = (pageNumber: number) => pageNumber <= 1 ? listPath : `${listPath}page/${pageNumber}/`;
---
<SiteLayout locale={locale} route={route} description={en ? `Questions for ${label}, grouped by the capability each one examines.` : `${label}相关的问题，按主要能力分组。`}>
  <p class="eyebrow">{eyebrow}</p>
  <h1 class="page-title">{label}</h1>
  {kind === 'roles' && <p class="model-note"><a href={pathFor({ type: 'role-stage-model', role: id }, locale, base)}>{en ? 'Compare expectations across career stages →' : '查看本岗位各阶段的责任与证据要求 →'}</a></p>}
  {kind === 'scenarios' && id === 'promotion' && pageWindow.page === 1 && <section class="promotion-guide" aria-labelledby="promotion-guide-heading">
    <div class="promotion-guide-intro">
      <div><p class="eyebrow">{en ? 'INTERNAL GROWTH' : '内部发展'}</p><h2 id="promotion-guide-heading">{en ? 'Prepare for promotion as a body of evidence' : '把晋升准备成一组持续证据'}</h2></div>
      <p>{en ? 'A promotion case asks whether you have sustained the next scope of responsibility and produced verifiable results over time. It is different from a one-off external interview.' : '晋升评审要判断你是否已持续承担下一范围的责任，并在一段时间内取得可核验的结果；它不同于一次外部求职面试。'}</p>
    </div>
    <p class="promotion-model-note">{en ? 'These are browsing paths through shared questions, not company level criteria. Map the evidence to your organization’s capability model and review period.' : '这是共用题库的浏览路径，不是公司职级标准。具体阶段要求和评审周期要以所在组织的能力模型为准。'}</p>
    <div class="promotion-lanes">
      {promotionLanes.map((lane) => <a class="promotion-lane" href={`${promotionQuestionPath}${lane.id}`}>
        <span>{en ? 'CAREER PATH' : '发展路径'}</span><strong>{lane.title}</strong><p>{lane.scope}</p>
        <span class="stage-link">{en ? 'Browse matching questions' : '浏览相关问题'} <Icon name="arrow-right" size={16} /></span>
      </a>)}
    </div>
    <div class="promotion-evidence">
      <h3>{en ? 'Build the case in four parts' : '用四部分整理晋升材料'}</h3>
      <ol>
        <li><strong>{en ? 'Target scope' : '目标范围'}</strong><span>{en ? 'Name the path and responsibilities expected next.' : '明确目标路径，以及下一阶段要承担的责任。'}</span></li>
        <li><strong>{en ? 'Sustained outcomes' : '持续结果'}</strong><span>{en ? 'Show the baseline, outcome, time span, and your attributable contribution.' : '呈现基线、结果、持续时间，以及可归因于自己的贡献。'}</span></li>
        <li><strong>{en ? 'How the result was achieved' : '结果如何产生'}</strong><span>{en ? 'Explain trade-offs, collaborators, risks, and what changed after setbacks.' : '解释取舍、协作者、风险，以及遇到挫折后做了什么调整。'}</span></li>
        <li><strong>{en ? 'Evidence and gaps' : '证据与差距'}</strong><span>{en ? 'Separate verified facts from claims, include counterevidence, and name the next gap to close.' : '区分核验事实与主张，呈现反向证据，并说明下一步要补足的差距。'}</span></li>
      </ol>
    </div>
    <p class="promotion-dialogue-link"><a href={promotionDialoguePath}>{en ? 'Questions to ask in a promotion conversation' : '晋升沟通时可以主动问什么'} <Icon name="arrow-right" size={16} /></a></p>
  </section>}
  <p class="intro">{intro}</p>
  <p class="result-count"><TargetCount questions={questions} locale={locale} unit /></p>
  {kind === 'scenarios' && pageWindow.page === 1 && coreQuestions.length > 0 && <section class="scenario-core-first" aria-labelledby="scenario-core-heading" data-core-first-section>
    <div class="collection-section-heading"><h2 id="scenario-core-heading" class="section-title">{en ? 'Reviewed core questions' : '逐题复核的核心题'}</h2><span class="count">{coreQuestions.length}</span></div>
    <p class="band-text">{en ? 'Each question below has a reviewed intent, signals, follow-ups, and evidence anchors.' : '每道题均已逐题复核考察意图、观察信号、追问和证据锚点。'}</p>
    {relevantCoreSets.length > 0 && <nav class="scenario-curated-sets" aria-label={en ? 'Relevant curated question sets' : '相关精选题单'} data-scenario-curated-sets><strong>{en ? 'Curated paths for this scenario' : '适合此场景的精选题单'}</strong>{relevantCoreSets.map(({ collection, matches }) => <a href={pathFor({ type: 'collection', id: collection.id }, locale, base)}>{pick(collection.title, locale)} <span>· {matches} {en ? 'matching questions' : '道匹配题'}</span></a>)}</nav>}
    <QuestionList questions={corePreviewQuestions} locale={locale} coreQuestionLinks />
    {remainingCoreQuestions.length > 0 && <details class="more-core-questions">
      <summary>{en ? `View all ${coreQuestions.length} reviewed core questions` : `查看全部 ${coreQuestions.length} 道已复核核心题`}</summary>
      <QuestionList questions={remainingCoreQuestions} locale={locale} coreQuestionLinks />
    </details>}
  </section>}
  {kind === 'scenarios' && extendedQuestions.length > 0 && <section aria-labelledby="scenario-extended-heading" data-extended-library>
    <h2 id="scenario-extended-heading" class="section-title">{en ? 'Extended library · not reviewed question by question' : '扩展题库 · 尚未逐题复核'}</h2>
    <p class="band-text">{en ? 'These questions remain useful for discovery, but have not received the same question-specific review as the core set.' : '这些问题可继续用于探索，但尚未接受与核心题同等的逐题内容复核。'}</p>
  </section>}
  {pageWindow.pageCount > 1 && <p class="band-text">{en ? `Extended questions ${pageWindow.start + 1}–${pageWindow.end} of ${extendedQuestions.length} on this page.` : `本页为扩展题库第 ${pageWindow.start + 1}–${pageWindow.end} 题，共 ${extendedQuestions.length} 题。`}</p>}
  {groups.map(({ domain, items }) => (
    <section class="leaf-section">
      <h2>{domain.letter} · {pick(domain.name, locale)}<TargetCount class="count" questions={items} /></h2>
      <QuestionList questions={items} locale={locale} />
    </section>
  ))}
  {pageWindow.pageCount > 1 && <nav class="library-pagination" aria-label={en ? 'Question pages' : '问题分页'}>
    {pageWindow.page > 1 ? <a href={pageHref(pageWindow.page - 1)} rel="prev">{en ? 'Previous page' : '上一页'}</a> : <span></span>}
    <span>{en ? `Page ${pageWindow.page} of ${pageWindow.pageCount}` : `第 ${pageWindow.page} / ${pageWindow.pageCount} 页`}</span>
    {pageWindow.page < pageWindow.pageCount ? <a href={pageHref(pageWindow.page + 1)} rel="next">{en ? 'Next page' : '下一页'}</a> : <span></span>}
  </nav>}
</SiteLayout>
