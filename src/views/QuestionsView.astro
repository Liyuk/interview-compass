---
import SiteLayout from '../layouts/SiteLayout.astro';
import { domains, facetDefinitions, facetKinds, facetMeta, pick, type FacetKind, type Locale } from '../lib/taxonomy';
import { facetCounts } from '../lib/question-catalog';
import { capabilityLabel } from '../lib/taxonomy';
import { pathFor } from '../lib/routes';
import { loadQuestions } from '../lib/site-data';

interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
const base = import.meta.env.BASE_URL;
const questions = await loadQuestions(locale);
const filterKinds = facetKinds;
const queryKey: Record<FacetKind, string> = { topics: 'topic', roles: 'role', responsibilityScopes: 'scope', careerTracks: 'track', scenarios: 'scenario', formats: 'format' };
const capabilityOptions = domains.flatMap((domain) => domain.leaves.map((leaf) => ({ id: `${domain.id}.${leaf.id}`, label: `${domain.letter} · ${pick(leaf.name, locale)}`, count: questions.filter((q) => q.primaryCapability === `${domain.id}.${leaf.id}`).length }))).filter((option) => option.count > 0);
const facetOptions = filterKinds.map((kind) => {
  const counts = facetCounts(questions, { locale, facet: kind });
  return { kind, options: facetDefinitions[kind].filter((entry) => counts.has(entry.id)).map((entry) => ({ id: entry.id, label: pick(entry.name, locale), count: counts.get(entry.id) ?? 0 })) };
}).filter((group) => group.options.length > 0);
---
<SiteLayout locale={locale} route={{ type: 'questions' }} description={en ? 'Browse and filter every published question.' : '浏览并筛选所有已发布的问题。'}>
  <h1 class="page-title">{en ? 'Question library' : '问题库'}</h1>
  <p class="intro">{en ? 'Each filter is an independent view of the same questions. Combining filters narrows the list, and the address bar keeps your selection so you can share it.' : '每个筛选项都是同一批题目的独立视角。组合筛选会缩小列表，地址栏会保留你的选择，方便分享。'}</p>

  <form class="filters" id="filters" aria-label={en ? 'Filter questions' : '筛选问题'}>
    <label>
      <span>{en ? 'Capability' : '能力'}</span>
      <select name="capability"><option value="">{en ? 'Any' : '全部'}</option>{capabilityOptions.map((o) => <option value={o.id}>{o.label} ({o.count})</option>)}</select>
    </label>
    {facetOptions.map((group) => (
      <label>
        <span>{pick(facetMeta[group.kind].name, locale)}</span>
        <select name={queryKey[group.kind]}><option value="">{en ? 'Any' : '全部'}</option>{group.options.map((o) => <option value={o.id}>{o.label} ({o.count})</option>)}</select>
      </label>
    ))}
    <button type="button" id="clear-filters">{en ? 'Clear filters' : '清除筛选'}</button>
  </form>
  <details class="filter-help">
    <summary>{en ? 'What do these filters mean?' : '这些筛选项是什么意思？'}</summary>
    <dl>
      <dt>{en ? 'Capability' : '能力'}</dt><dd>{en ? 'The one thing a question is mainly meant to examine. Each question has exactly one.' : '一道题主要想考察的那一件事。每道题只有一个。'}</dd>
      {facetOptions.map((group) => <><dt>{pick(facetMeta[group.kind].name, locale)}</dt><dd>{pick(facetMeta[group.kind].description, locale)}</dd></>)}
    </dl>
  </details>

  <p id="result-count" class="result-count" role="status" aria-live="polite">{en ? `${questions.length} questions` : `${questions.length} 道问题`}</p>
  <ul class="question-list" id="question-list">
    {questions.map((q) => (
      <li
        data-capability={q.primaryCapability}
        data-topic={q.topics.join(' ')}
        data-role={q.roles.join(' ')}
        data-scope={q.responsibilityScopes.join(' ')}
        data-track={q.careerTracks.join(' ')}
        data-scenario={q.scenarios.join(' ')}
        data-format={(q.formats ?? []).join(' ')}
      >
        <a href={pathFor({ type: 'question', questionId: q.questionId, capability: q.primaryCapability, title: q.title }, locale, base)}>
          <span class="question-text">{q.question}</span>
          <span class="question-meta">{capabilityLabel(q.primaryCapability, locale)}</span>
        </a>
      </li>
    ))}
  </ul>
  <p id="no-results" class="empty-state" hidden>{en ? 'No question matches every filter. Try clearing one.' : '没有题目同时满足所有筛选项，试着去掉一个。'}</p>

  <script is:inline define:vars={{ en }}>
    const form = document.getElementById('filters');
    const items = [...document.querySelectorAll('#question-list > li')];
    const count = document.getElementById('result-count');
    const empty = document.getElementById('no-results');
    const keys = [...form.querySelectorAll('select')].map((select) => select.name);
    const attr = (name) => (name === 'capability' ? 'capability' : name);
    function apply(writeUrl) {
      const params = new URLSearchParams();
      for (const key of keys) { const value = form.elements[key].value; if (value) params.set(key, value); }
      let shown = 0;
      for (const item of items) {
        const match = keys.every((key) => {
          const wanted = form.elements[key].value;
          if (!wanted) return true;
          return (item.dataset[attr(key)] || '').split(' ').includes(wanted);
        });
        item.hidden = !match;
        if (match) shown += 1;
      }
      count.textContent = en ? `${shown} questions` : `${shown} 道问题`;
      empty.hidden = shown !== 0;
      if (writeUrl) {
        const query = params.toString();
        history.replaceState(null, '', query ? `?${query}` : location.pathname);
      }
    }
    const initial = new URLSearchParams(location.search);
    for (const key of keys) if (initial.has(key)) form.elements[key].value = initial.get(key);
    form.addEventListener('change', () => apply(true));
    document.getElementById('clear-filters').addEventListener('click', () => {
      for (const key of keys) form.elements[key].value = '';
      apply(true);
    });
    apply(false);
  </script>
</SiteLayout>
