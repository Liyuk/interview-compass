---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getQuestions } from '../../lib/question-catalog';
import { addBase } from '../../lib/locale-paths';
const entries = await getCollection('questions');
const questions = getQuestions(entries.map(({ data }) => data), { locale: 'zh-CN', scenario: 'promotion' });
const base = import.meta.env.BASE_URL;
---
<SiteLayout locale="zh-CN" title="晋升问题" description="按晋升场景探索面试与能力问题。" switchPath={addBase('/en/promotion/', base)}><div class="page-shell"><aside class="side-nav"><h2>晋升</h2><ul><li><a href={addBase('/questions/', base)}>问题索引</a></li><li><a href={addBase('/topics/', base)}>主题</a></li></ul></aside><main class="main-content" data-pagefind-body><nav class="breadcrumbs"><a href={addBase('/', base)}>首页</a><span>›</span><span>晋升</span></nav><p class="eyebrow">PROMOTION</p><h1 class="page-title">晋升与成长</h1><p class="intro">从过去的事实、工作范围与可度量结果出发，探索晋升讨论中的能力与影响。</p><ul class="question-list">{questions.map((q) => <li><a href={addBase(`/questions/${q.questionId}/`, base)}><span>{q.question}</span><span class="question-id">{q.questionId}　›</span></a></li>)}</ul></main></div></SiteLayout>
