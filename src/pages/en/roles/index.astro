---
import { getCollection } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { getQuestions } from '../../../lib/question-catalog';
import { roleEntries } from '../../../lib/labels';
import { addBase } from '../../../lib/locale-paths';
const entries = await getCollection('questions');
const questions = getQuestions(entries.map(({ data }) => data), { locale: 'en' });
const roles = roleEntries('en').filter(({ id }) => questions.some((q) => q.roles.includes(id)));
const base = import.meta.env.BASE_URL;
---
<SiteLayout locale="en" title="Browse by role" description="Find interview prompts by role." switchPath={addBase('/roles/', base)}><div class="page-shell"><aside class="side-nav"><h2>Browse</h2><ul><li><a href={addBase('/en/questions/', base)}>Questions</a></li><li><a href={addBase('/en/topics/', base)}>Topics</a></li></ul></aside><main class="main-content"><nav class="breadcrumbs"><a href={addBase('/en/', base)}>Home</a><span>›</span><span>Roles</span></nav><h1 class="page-title">Browse by role</h1><p class="intro">Roles provide a work context. The same topic can have different boundaries in product, engineering, operations, and management.</p><div class="facet-grid">{roles.map(({ id, label }) => <a class="facet-card" href={addBase(`/en/roles/${id}/`, base)}><strong>{label}</strong><span>{questions.filter((q) => q.roles.includes(id)).length} questions</span></a>)}</div></main></div></SiteLayout>
