---
import FacetView from '../../../views/FacetView.astro';
import { facetStaticPaths } from '../../../lib/site-data';
const locale = 'en' as const;
export function getStaticPaths() { return facetStaticPaths('roles', 'en'); }
const { id } = Astro.params as Record<string, string>;
---
<FacetView locale={locale} kind="roles" id={id} />
