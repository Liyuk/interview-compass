---
import { getCollection } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { getQuestions } from '../../../lib/question-catalog';
import { addBase } from '../../../lib/locale-paths';
const entries = await getCollection('questions');
const questions = getQuestions(entries.map(({ data }) => data), { locale: 'en' });
const base = import.meta.env.BASE_URL;
---
<SiteLayout locale="en" title="Question index" description="Browse all published interview and promotion questions." switchPath={addBase('/questions/', base)}>
  <div class="page-shell"><aside class="side-nav"><h2>Question index</h2><p class="detail-copy">{questions.length} bilingual prompts</p></aside><main class="main-content" data-pagefind-body><nav class="breadcrumbs"><a href={addBase('/en/', base)}>Home</a><span>›</span><span>Question index</span></nav><h1 class="page-title">Question index</h1><p class="intro">Each question includes its intent, capability and topic tags, plus comparisons to related prompts.</p><ul class="question-list">{questions.map((q) => <li><a href={addBase(`/en/questions/${q.questionId}/`, base)}><span>{q.question}</span><span class="question-id">{q.questionId}　›</span></a></li>)}</ul></main></div>
</SiteLayout>
