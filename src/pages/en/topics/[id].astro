---
import { getCollection } from 'astro:content';
import FacetPage from '../../../components/FacetPage.astro';
import { getQuestions } from '../../../lib/question-catalog';
import { topicEntries } from '../../../lib/labels';

export async function getStaticPaths() {
  const entries = await getCollection('questions');
  const records = entries.map(({ data }) => data);
  const en = getQuestions(records, { locale: 'en' });
  return topicEntries('en').filter(({ id }) => en.some((q) => q.topics.includes(id))).map(({ id, label }) => ({ params: { id }, props: { id, label, questions: en.filter((q) => q.topics.includes(id)), locale: 'en' } }));
}
const { id, label, questions, locale } = Astro.props;
---
<FacetPage facet="topic" id={id} label={label} questions={questions} locale={locale} />
