---
import { getCollection } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { getQuestions } from '../../../lib/question-catalog';
import { topicEntries } from '../../../lib/labels';
import { addBase } from '../../../lib/locale-paths';
const entries = await getCollection('questions');
const questions = getQuestions(entries.map(({ data }) => data), { locale: 'en' });
const topics = topicEntries('en').filter(({ id }) => questions.some((q) => q.topics.includes(id)));
const base = import.meta.env.BASE_URL;
---
<SiteLayout locale="en" title="Browse by topic" description="Find interview and promotion questions by topic." switchPath={addBase('/topics/', base)}><div class="page-shell"><aside class="side-nav"><h2>Browse</h2><ul><li><a href={addBase('/en/questions/', base)}>Questions</a></li><li><a href={addBase('/en/roles/', base)}>Roles</a></li></ul></aside><main class="main-content"><nav class="breadcrumbs"><a href={addBase('/en/', base)}>Home</a><span>›</span><span>Topics</span></nav><h1 class="page-title">Browse by topic</h1><p class="intro">A question can span several topics. Start here to see how the same capability appears in different contexts.</p><div class="facet-grid">{topics.map(({ id, label }) => <a class="facet-card" href={addBase(`/en/topics/${id}/`, base)}><strong>{label}</strong><span>{questions.filter((q) => q.topics.includes(id)).length} questions</span></a>)}</div></main></div></SiteLayout>
