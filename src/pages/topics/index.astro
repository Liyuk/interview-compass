---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getQuestions } from '../../lib/question-catalog';
import { topicEntries } from '../../lib/labels';
import { addBase } from '../../lib/locale-paths';
const entries = await getCollection('questions');
const questions = getQuestions(entries.map(({ data }) => data), { locale: 'zh-CN' });
const topics = topicEntries('zh-CN').filter(({ id }) => questions.some((q) => q.topics.includes(id)));
const base = import.meta.env.BASE_URL;
---
<SiteLayout locale="zh-CN" title="按主题浏览" description="按主题查找面试和晋升问题。" switchPath={addBase('/en/topics/', base)}><div class="page-shell"><aside class="side-nav"><h2>浏览方式</h2><ul><li><a href={addBase('/questions/', base)}>问题索引</a></li><li><a href={addBase('/roles/', base)}>岗位</a></li></ul></aside><main class="main-content"><nav class="breadcrumbs"><a href={addBase('/', base)}>首页</a><span>›</span><span>主题</span></nav><h1 class="page-title">按主题浏览</h1><p class="intro">一个问题可以跨越多个主题；从主题进入，可以看到同一能力在不同场景下的提问方式。</p><div class="facet-grid">{topics.map(({ id, label }) => <a class="facet-card" href={addBase(`/topics/${id}/`, base)}><strong>{label}</strong><span>{questions.filter((q) => q.topics.includes(id)).length} 道问题</span></a>)}</div></main></div></SiteLayout>
