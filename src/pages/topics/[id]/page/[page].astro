---
import FacetView from '../../../../views/FacetView.astro';
import { facetPageStaticPaths } from '../../../../lib/site-data';
export function getStaticPaths() { return facetPageStaticPaths('topics', 'zh-CN'); }
const { id, page } = Astro.params as Record<string, string>;
---
<FacetView locale="zh-CN" kind="topics" id={id} page={Number(page)} />
