---
import { getCollection } from 'astro:content';
import FacetPage from '../../components/FacetPage.astro';
import { getQuestions } from '../../lib/question-catalog';
import { roleEntries } from '../../lib/labels';

export async function getStaticPaths() {
  const entries = await getCollection('questions');
  const records = entries.map(({ data }) => data);
  const zh = getQuestions(records, { locale: 'zh-CN' });
  return roleEntries('zh-CN').filter(({ id }) => zh.some((q) => q.roles.includes(id))).map(({ id, label }) => ({ params: { id }, props: { id, label, questions: zh.filter((q) => q.roles.includes(id)), locale: 'zh-CN' } }));
}
const { id, label, questions, locale } = Astro.props;
---
<FacetPage facet="role" id={id} label={label} questions={questions} locale={locale} />
