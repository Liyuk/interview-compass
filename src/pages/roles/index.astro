---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getQuestions } from '../../lib/question-catalog';
import { roleEntries } from '../../lib/labels';
import { addBase } from '../../lib/locale-paths';
const entries = await getCollection('questions');
const questions = getQuestions(entries.map(({ data }) => data), { locale: 'zh-CN' });
const roles = roleEntries('zh-CN').filter(({ id }) => questions.some((q) => q.roles.includes(id)));
const base = import.meta.env.BASE_URL;
---
<SiteLayout locale="zh-CN" title="按岗位浏览" description="按职能岗位查找面试问题。" switchPath={addBase('/en/roles/', base)}><div class="page-shell"><aside class="side-nav"><h2>浏览方式</h2><ul><li><a href={addBase('/questions/', base)}>问题索引</a></li><li><a href={addBase('/topics/', base)}>主题</a></li></ul></aside><main class="main-content"><nav class="breadcrumbs"><a href={addBase('/', base)}>首页</a><span>›</span><span>岗位</span></nav><h1 class="page-title">按岗位浏览</h1><p class="intro">岗位决定问题出现的工作语境；同一主题在产品、工程、运营与管理岗位中会有不同边界。</p><div class="facet-grid">{roles.map(({ id, label }) => <a class="facet-card" href={addBase(`/roles/${id}/`, base)}><strong>{label}</strong><span>{questions.filter((q) => q.roles.includes(id)).length} 道问题</span></a>)}</div></main></div></SiteLayout>
