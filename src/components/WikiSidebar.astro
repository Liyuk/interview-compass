---
import { wikiNavigationFor } from '../lib/wiki-navigation';
import type { RouteRef } from '../lib/routes';
import type { Locale } from '../lib/taxonomy';
import type { PageSection } from '../lib/page-presentation';
import WikiNavList from './WikiNavList.astro';

interface Props {
  route: RouteRef;
  locale: Locale;
  base?: string;
  idPrefix?: string;
  mobileDisclosure?: boolean;
  section?: PageSection;
}

const { route, locale, base = '', idPrefix = 'wiki', mobileDisclosure = true, section } = Astro.props;
const group = section === 'browse' ? 'category-browsing' : section === 'stages' ? 'capabilities-and-stages' : section === 'goals' ? 'question-library' : section === 'methods' || section === 'guide' ? 'methods-and-guide' : undefined;
const sections = wikiNavigationFor(route, locale, base).filter(item => !group || item.key === group).map(item => section === 'goals' ? { ...item, items: item.items.filter(link => link.key === 'paths').map(link => ({ ...link, current: route.type === 'scenarios', label: locale === 'en' ? 'Goal paths' : '目标路径' })) } : item);
const navId = `${idPrefix}-knowledge-navigation`;
const label = locale === 'en' ? 'Knowledge navigation' : '知识导航';
const summaryLabel = locale === 'en' ? 'Browse knowledge' : '浏览知识目录';

---

<aside class="wiki-sidebar" data-wiki-sidebar data-mobile-disclosure={mobileDisclosure ? 'true' : 'false'}>
  {mobileDisclosure && <details open data-wiki-disclosure>
    <summary aria-controls={navId} aria-expanded="true">
      <span>{summaryLabel}</span>
      <span class="wiki-disclosure-icon" aria-hidden="true">⌄</span>
    </summary>
    <nav id={navId} aria-label={label}>
      {sections.map(section => <section class="wiki-nav-section" aria-labelledby={`${idPrefix}-${section.key}`}>
        <p id={`${idPrefix}-${section.key}`}>{section.label}</p>
        <WikiNavList items={section.items} />
      </section>)}
    </nav>
  </details>}
  {!mobileDisclosure && <nav id={navId} aria-label={label}>
    {sections.map(section => <section class="wiki-nav-section" aria-labelledby={`${idPrefix}-${section.key}`}>
      <p id={`${idPrefix}-${section.key}`}>{section.label}</p>
      <WikiNavList items={section.items} />
    </section>)}
  </nav>}
</aside>

{mobileDisclosure && <script is:inline>
{
  const sidebar = document.querySelector('[data-wiki-sidebar][data-mobile-disclosure="true"]');
  const disclosure = sidebar?.querySelector('[data-wiki-disclosure]');
  const summary = disclosure?.querySelector('summary');
  const media = window.matchMedia('(max-width: 760px)');

  const syncExpanded = () => summary?.setAttribute('aria-expanded', String(Boolean(disclosure?.open)));
  const syncViewport = () => {
    if (!disclosure) return;
    if (media.matches) disclosure.open = false;
    else disclosure.open = true;
    syncExpanded();
  };

  syncViewport();
  media.addEventListener('change', syncViewport);
  disclosure?.addEventListener('toggle', syncExpanded);
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && media.matches && disclosure?.open) {
      disclosure.open = false;
      syncExpanded();
      summary?.focus();
    }
  });
  disclosure?.querySelectorAll('nav a').forEach(link => link.addEventListener('click', () => {
    if (media.matches && disclosure.open) disclosure.open = false;
  }));
}
</script>}
