---
import { capabilityLabel, type Locale } from '../lib/taxonomy';
import { pathFor } from '../lib/routes';
import type { BrowseRecord } from '../lib/question-catalog';

interface Props { questions: BrowseRecord[]; locale: Locale; showCapability?: boolean; emptyText?: string }
const { questions, locale, showCapability = true, emptyText } = Astro.props;
const en = locale === 'en';
const base = import.meta.env.BASE_URL;
---
{questions.length === 0
  ? <p class="empty-state">{emptyText ?? (en ? 'No published questions here yet.' : '这里暂时还没有已发布的问题。')}</p>
  : <ul class="question-list">
      {questions.map((q) => (
        <li data-question-id={q.questionId}>
          <a href={pathFor({ type: 'question', questionId: q.questionId, capability: q.primaryCapability, title: q.title }, locale, base)}>
            <span class="question-text">{q.question}</span>
            {showCapability && <span class="question-meta">{capabilityLabel(q.primaryCapability, locale)}</span>}
          </a>
        </li>
      ))}
    </ul>}
