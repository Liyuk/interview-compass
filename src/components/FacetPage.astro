---
import SiteLayout from '../layouts/SiteLayout.astro';
import { addBase } from '../lib/locale-paths';
import type { Locale } from '../lib/taxonomy';
import type { BrowseRecord } from '../lib/question-catalog';
interface Props { facet: 'topic' | 'role'; id: string; label: string; questions: BrowseRecord[]; locale: Locale }
const { facet, id, label, questions, locale } = Astro.props;
const en = locale === 'en';
const base = import.meta.env.BASE_URL;
const isTopic = facet === 'topic';
const parent = isTopic ? (en ? '/en/topics/' : '/topics/') : (en ? '/en/roles/' : '/roles/');
const questionBase = en ? '/en/questions/' : '/questions/';
const switchPath = addBase(`${en ? '' : '/en'}${isTopic ? '/topics/' : '/roles/'}${id}/`, base);
---
<SiteLayout locale={locale as Locale} title={label} description={en ? `Interview questions about ${label}.` : `${label} 相关的面试与晋升问题。`} switchPath={switchPath}>
  <div class="page-shell">
    <aside class="side-nav"><h2>{isTopic ? (en ? 'Topics' : '主题') : (en ? 'Roles' : '岗位')}</h2><ul><li><a href={addBase(parent, base)}>{en ? `All ${isTopic ? 'topics' : 'roles'}` : `全部${isTopic ? '主题' : '岗位'}`}</a></li><li><a href={addBase(en ? '/en/questions/' : '/questions/', base)}>{en ? 'Question index' : '问题索引'}</a></li></ul></aside>
    <main class="main-content" data-pagefind-body>
      <nav class="breadcrumbs"><a href={addBase(en ? '/en/' : '/', base)}>{en ? 'Home' : '首页'}</a><span>›</span><a href={addBase(parent, base)}>{isTopic ? (en ? 'Topics' : '主题') : (en ? 'Roles' : '岗位')}</a><span>›</span><span>{label}</span></nav>
      <p class="eyebrow">{isTopic ? (en ? 'TOPIC' : '主题') : (en ? 'ROLE' : '岗位')}</p>
      <h1 class="page-title">{label}</h1>
      <p class="intro">{en ? `Questions connected to ${label}. Compare their intent and context to see how the capability changes across situations.` : `浏览与${label}相关的问题。对照考察意图和工作语境，理解同一能力在不同场景中的变化。`}</p>
      {questions.length ? <ul class="question-list">{questions.map((question: BrowseRecord) => <li><a href={addBase(`${questionBase}${question.questionId}/`, base)}><span>{question.question}</span><span class="question-id">{question.questionId}　›</span></a></li>)}</ul> : <p class="empty-state">{en ? 'No published questions in this category yet.' : '这个分类暂时还没有已发布的问题。'}</p>}
    </main>
  </div>
</SiteLayout>
