---
import ArticleOutline from '../docs/ArticleOutline.astro';
import { handbookSections } from '../../lib/article-sections';
import type { ArticleHeading } from '../../lib/knowledge/outline';
const locale = Astro.locals.starlightRoute.locale === 'en' ? 'en' : 'zh-CN';
const headings: ArticleHeading[] = Astro.locals.starlightRoute.headings
  .filter(item => item.depth >= 2 && item.depth <= 3)
  .map(item => ({ id: item.slug, label: item.text, level: item.depth as 2 | 3, sectionKey: handbookSections.find(section => section.anchors[locale] === item.slug)?.sectionKey ?? item.slug }));
---
<ArticleOutline headings={headings} locale={locale} />
