---
import SiteMasthead from '../SiteMasthead.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import { breadcrumbsFor } from '../../lib/routes';
import type { Locale } from '../../lib/taxonomy';

const route = Astro.locals.starlightRoute;
const locale: Locale = route.locale === 'en' ? 'en' : 'zh-CN';
const crumbs = breadcrumbsFor({ type: 'guide' }, locale, import.meta.env.BASE_URL);
---

<SiteMasthead locale={locale} active="guide" route={{ type: 'guide' }} />
<div class="page-frame handbook-crumbs"><Breadcrumbs crumbs={crumbs} locale={locale} /></div>

<style is:global>
  :root { --sl-nav-height: 176px; }
  .page .header { display: block; height: var(--sl-nav-height); padding: 0; border: 0; background: var(--page); }
  .handbook-crumbs { padding-top: 7px; padding-bottom: 0; }
  .handbook-crumbs .breadcrumbs { margin: 0; }
  @media (max-width: 760px) {
    :root { --sl-nav-height: 196px; }
    .page .header { height: var(--sl-nav-height); }
    .handbook-crumbs { padding-top: 7px; }
  }
</style>
