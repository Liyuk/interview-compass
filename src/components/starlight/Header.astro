---
import SectionTranslations from '../docs/SectionTranslations.astro';
import { handbookSections } from '../../lib/article-sections';
import SiteMasthead from '../SiteMasthead.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import { breadcrumbsFor } from '../../lib/routes';
import type { Locale } from '../../lib/taxonomy';

const route = Astro.locals.starlightRoute;
const locale: Locale = route.locale === 'en' ? 'en' : 'zh-CN';
const crumbs = breadcrumbsFor({ type: 'guide' }, locale, import.meta.env.BASE_URL);
---

<span hidden data-pagefind-filter={`locale:${locale}`} />
<span hidden data-pagefind-filter="kind:docs" data-pagefind-sort="title[data-sort-title]" data-sort-title={locale === 'en' ? 'Handbook' : '使用说明'} />
<SiteMasthead locale={locale} active="guide" route={{ type: 'guide' }} wiki />
<SectionTranslations sections={handbookSections} />
<div class="page-frame handbook-crumbs"><Breadcrumbs crumbs={crumbs} locale={locale} /></div>
