---
const { hasSidebar } = Astro.locals.starlightRoute;
---
<div class="page handbook-page">
  <header class="header"><slot name="header" /></header>
  <div class="handbook-reading-frame">
    {hasSidebar && <aside class="handbook-section-nav"><slot name="sidebar" /></aside>}
    <div class="main-frame"><slot /></div>
  </div>
</div>
<style is:global>
  :root { --sl-nav-height: 0px; --sl-content-inline-start: 0rem; }
  .handbook-page > .header { position: relative; width: 100%; height: auto; padding: 0; background: var(--page); z-index: 12; }
  .handbook-reading-frame { max-width: 1505px; margin-inline: auto; display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 32px; padding: 24px clamp(20px, 3vw, 46px); }
  .handbook-section-nav { min-width: 0; }
  .handbook-reading-frame > .main-frame { min-width: 0; padding: 0; }
  .handbook-reading-frame .main-pane { padding-top: 0; }
  .handbook-page main { margin-top: 0; }
  .handbook-page .handbook-crumbs { padding-block: 12px 0; }
  .handbook-page .handbook-crumbs .breadcrumbs { margin: 0; }
  .handbook-page .right-sidebar { position: sticky; top: 20px; width: 100%; height: auto; max-height: calc(100dvh - 40px); }
  @media (max-width: 760px) {
    .handbook-reading-frame { display: block; padding-inline: 18px; }
    .handbook-page .wiki-sidebar > details > summary { display: flex; }
    .handbook-page .wiki-sidebar { margin-bottom: 18px; }
    .handbook-page mobile-starlight-toc nav { position: relative; top: auto; width: 100%; }
    .handbook-page main { margin-top: 0; }
    .handbook-page .header .site-header { padding-inline-end: 18px; }
  }
</style>
