---
import '../styles/global.css';
import Icon from './Icon.astro';
import { pathFor, switchLocaleRoute, type RouteRef } from '../lib/routes';
import type { Locale } from '../lib/taxonomy';
import { loadQuestions } from '../lib/site-data';
import { siteNavigationFor } from '../lib/site-navigation';
import TargetCount from './TargetCount.astro';

interface Props { locale: Locale; active?: string; route?: RouteRef; wiki?: boolean }
const { locale, route = { type: 'home' } } = Astro.props;
const en = locale === 'en';
const base = import.meta.env.BASE_URL;
const other: Locale = en ? 'zh-CN' : 'en';
const questions = await loadQuestions(locale);
const nav = siteNavigationFor(route, locale, base);
---
<script is:inline>
  document.body.dataset.navigationReady = 'true';
  document.documentElement.dataset.targetPending = 'true';
  document.documentElement.dataset.targetEnabled = 'true';
  setTimeout(() => { delete document.documentElement.dataset.targetPending; document.querySelectorAll('[data-library-pending]').forEach(element => element.removeAttribute('data-library-pending')); }, 2500);
</script>

<noscript><style>.preparation-target-action,.target-status,.nav-toggle,.search-strip{display:none!important}.wiki-sidebar>details>nav{position:static!important;max-height:none!important;box-shadow:none!important}</style></noscript>
<header class="site-header">
  <a class="wordmark" href={pathFor({ type: 'home' }, locale, base)}>
    <img src={`${base.endsWith('/') ? base : `${base}/`}logo.svg`} width="30" height="30" alt="" aria-hidden="true" />
    <span>Interview Compass</span>
  </a>
    <button class="nav-toggle" data-site-navigation-toggle type="button" aria-expanded="false" aria-controls="primary-navigation">{en ? 'Menu' : '导航'} <Icon name="chevron-down" size={16} /></button>
    <nav id="primary-navigation" class="primary-nav" data-site-navigation aria-label={en ? 'Main navigation' : '主导航'}>
      {nav.map((item) => <a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a>)}
    </nav>
  <div class="target-status">
  <button type="button" class="profile-trigger" data-profile-trigger aria-expanded="false" aria-controls="target-status-panel">
    <span data-profile-label>{en ? 'Preparation target' : '准备目标'}</span>
    <Icon name="chevron-down" size={16} />
  </button>
<div id="target-status-panel" class="target-summary" data-target-summary hidden data-pagefind-ignore aria-label={en ? 'Preparation status' : '准备状态'}>
  <div class="target-summary-inner">
    <div class="target-summary-copy"><p class="target-summary-current"><span data-target-description></span><span class="target-summary-count"><TargetCount questions={questions} locale={locale} unit /></span></p>
      <p data-target-storage-warning hidden>{en ? 'Could not save this preference. Your choice applies only to this page.' : '未能保存此选择，仅在当前页有效。'}</p>
    </div>
    <div class="target-summary-actions"><button type="button" data-edit-target>{en ? 'Change target' : '切换目标'}</button><button type="button" data-view-all-target>{en ? 'View all questions' : '查看全部题目'}</button><button type="button" data-adopt-target hidden>{en ? 'Save as my default' : '设为我的默认'}</button><button type="button" data-remove-link-target hidden>{en ? 'Remove link target' : '移除链接目标'}</button><a data-target-model hidden>{en ? 'Stage expectations' : '阶段要求'}<Icon name="arrow-up-right" size={14} /></a></div>
  </div>
</div>
  </div>
  <dialog class="profile-dialog" data-profile-dialog aria-labelledby="profile-dialog-title" aria-describedby="profile-dialog-description">
    <h2 id="profile-dialog-title">{en ? 'Choose your preparation target' : '选择你的准备目标'}</h2>
    <p id="profile-dialog-description">{en ? 'For engineers: choose your specialization and target responsibility. Questions and search will show only reviewed matches. You can switch or explore everything at any time.' : '面向工程师，选择专业方向和准备承担的责任阶段。题目与搜索将只显示已审核的匹配内容，随时可以切换或查看全部。'}</p>
    <p data-profile-error role="status" hidden>{en ? 'Preparation targets could not load. Retry or browse all questions.' : '准备目标暂时无法加载，请重试或先浏览全部题目。'}</p>
    <button type="button" class="secondary-button" data-profile-retry hidden>{en ? 'Retry' : '重试加载'}</button>
    <label for="profile-role">{en ? 'Role type' : '岗位类型'}</label>
    <span class="select-control"><select id="profile-role"><option value="">{en ? 'Choose a role' : '选择岗位'}</option></select><Icon name="chevron-down" size={16} /></span>
    <label for="profile-stage">{en ? 'Target stage' : '目标阶段'}</label>
    <span class="select-control"><select id="profile-stage" disabled><option value="">{en ? 'Choose a stage' : '选择阶段'}</option></select><Icon name="chevron-down" size={16} /></span>
    <p class="profile-stage-description" data-profile-stage-description aria-live="polite">{en ? 'Stages describe responsibility, not years of experience or company title equivalence.' : '阶段表示责任要求，不按年限或公司职级名称换算。'}</p>
    <div class="profile-dialog-actions">
      <button type="button" class="profile-apply" data-profile-apply disabled>{en ? 'Browse this target' : '按此目标浏览'}</button>
      <button type="button" class="secondary-button" data-profile-all>{en ? 'Explore all questions' : '先看全部题目'}</button>
    </div>
    <p class="profile-local-note">{en ? 'Saved only in this browser. No account required.' : '仅保存在当前浏览器，无需账号。'}</p>
    <button type="button" class="profile-close" data-profile-close aria-label={en ? 'Close target selection' : '关闭目标选择'}>{en ? 'Close' : '关闭'}</button>
  </dialog>
  <div class="language-switch" role="group" aria-label={en ? 'Language' : '语言'}>
    <span aria-current="true">{en ? 'EN' : '中文'}</span><span aria-hidden="true"> / </span>
    <a href={switchLocaleRoute(route, other, base)} lang={other} hreflang={other}>{en ? '中文' : 'EN'}</a>
  </div>
</header>
<div class="search-strip"><div class="search-container">
  <form class="search-form" role="search" data-pagefind-search action={pathFor({ type: 'search' }, locale, base)} method="get">
    <label class="sr-only" for="site-search">{en ? 'Search questions, topics, or keywords' : '搜索问题、主题或关键词'}</label>
    <Icon name="search" size={21} class="search-icon" />
    <input id="site-search" name="q" type="search" placeholder={en ? 'Search questions, topics, or keywords' : '搜索问题、主题或关键词'} autocomplete="off" />
    <button type="submit">{en ? 'Search' : '搜索'}</button>
  </form>
  <div class="search-results" aria-live="polite" hidden></div>
</div></div>


<script>import '../lib/masthead-client';</script>
