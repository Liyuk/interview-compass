---
import '../styles/global.css';
import Icon from './Icon.astro';
import { pathFor, switchLocaleRoute, type RouteRef } from '../lib/routes';
import type { Locale } from '../lib/taxonomy';
import { loadQuestions } from '../lib/site-data';
import { siteNavigationFor } from '../lib/site-navigation';
import TargetCount from './TargetCount.astro';

interface Props { locale: Locale; active?: string; route?: RouteRef; wiki?: boolean }
const { locale, route = { type: 'home' } } = Astro.props;
const en = locale === 'en';
const base = import.meta.env.BASE_URL;
const other: Locale = en ? 'zh-CN' : 'en';
const questions = await loadQuestions(locale);
const nav = siteNavigationFor(route, locale, base);
---
<script is:inline>
  document.body.dataset.navigationReady = 'true';
  document.documentElement.dataset.targetPending = 'true';
  document.documentElement.dataset.targetEnabled = 'true';
  setTimeout(() => { delete document.documentElement.dataset.targetPending; document.querySelectorAll('[data-library-pending]').forEach(element => element.removeAttribute('data-library-pending')); }, 2500);
</script>

<header class="site-header">
  <a class="wordmark" href={pathFor({ type: 'home' }, locale, base)}>
    <img src={`${base.endsWith('/') ? base : `${base}/`}logo.svg`} width="30" height="30" alt="" aria-hidden="true" />
    <span>Interview Compass</span>
  </a>
    <button class="nav-toggle" data-site-navigation-toggle type="button" aria-expanded="false" aria-controls="primary-navigation">{en ? 'Menu' : '导航'} <Icon name="chevron-down" size={16} /></button>
    <nav id="primary-navigation" class="primary-nav" data-site-navigation aria-label={en ? 'Main navigation' : '主导航'}>
      {nav.map((item) => <a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a>)}
    </nav>
  <div class="target-status">
  <button type="button" class="profile-trigger" data-profile-trigger aria-expanded="false" aria-controls="target-status-panel">
    <span data-profile-label>{en ? 'Preparation target' : '准备目标'}</span>
    <Icon name="chevron-down" size={16} />
  </button>
<div id="target-status-panel" class="target-summary" data-target-summary hidden data-pagefind-ignore aria-label={en ? 'Preparation status' : '准备状态'}>
  <div class="target-summary-inner">
    <div class="target-summary-copy"><p class="target-summary-current"><span data-target-description></span><span class="target-summary-count"><TargetCount questions={questions} locale={locale} unit /></span></p>
      <p data-target-storage-warning hidden>{en ? 'Could not save this preference. Your choice applies only to this page.' : '未能保存此选择，仅在当前页有效。'}</p>
    </div>
    <div class="target-summary-actions"><button type="button" data-edit-target>{en ? 'Change target' : '切换目标'}</button><button type="button" data-view-all-target>{en ? 'View all questions' : '查看全部题目'}</button><button type="button" data-adopt-target hidden>{en ? 'Save as my default' : '设为我的默认'}</button><button type="button" data-remove-link-target hidden>{en ? 'Remove link target' : '移除链接目标'}</button><a data-target-model hidden>{en ? 'Stage expectations' : '阶段要求'}<Icon name="arrow-up-right" size={14} /></a></div>
  </div>
</div>
  </div>
  <dialog class="profile-dialog" data-profile-dialog aria-labelledby="profile-dialog-title" aria-describedby="profile-dialog-description">
    <h2 id="profile-dialog-title">{en ? 'Choose your preparation target' : '选择你的准备目标'}</h2>
    <p id="profile-dialog-description">{en ? 'For engineers: choose your specialization and target responsibility. Questions and search will show only reviewed matches. You can switch or explore everything at any time.' : '面向工程师，选择专业方向和准备承担的责任阶段。题目与搜索将只显示已审核的匹配内容，随时可以切换或查看全部。'}</p>
    <p data-profile-error role="status" hidden>{en ? 'Preparation targets could not load. Retry or browse all questions.' : '准备目标暂时无法加载，请重试或先浏览全部题目。'}</p>
    <button type="button" class="secondary-button" data-profile-retry hidden>{en ? 'Retry' : '重试加载'}</button>
    <label for="profile-role">{en ? 'Role type' : '岗位类型'}</label>
    <span class="select-control"><select id="profile-role"><option value="">{en ? 'Choose a role' : '选择岗位'}</option></select><Icon name="chevron-down" size={16} /></span>
    <label for="profile-stage">{en ? 'Target stage' : '目标阶段'}</label>
    <span class="select-control"><select id="profile-stage" disabled><option value="">{en ? 'Choose a stage' : '选择阶段'}</option></select><Icon name="chevron-down" size={16} /></span>
    <p class="profile-stage-description" data-profile-stage-description aria-live="polite">{en ? 'Stages describe responsibility, not years of experience or company title equivalence.' : '阶段表示责任要求，不按年限或公司职级名称换算。'}</p>
    <div class="profile-dialog-actions">
      <button type="button" class="profile-apply" data-profile-apply disabled>{en ? 'Browse this target' : '按此目标浏览'}</button>
      <button type="button" class="secondary-button" data-profile-all>{en ? 'Explore all questions' : '先看全部题目'}</button>
    </div>
    <p class="profile-local-note">{en ? 'Saved only in this browser. No account required.' : '仅保存在当前浏览器，无需账号。'}</p>
    <button type="button" class="profile-close" data-profile-close aria-label={en ? 'Close target selection' : '关闭目标选择'}>{en ? 'Close' : '关闭'}</button>
  </dialog>
  <div class="language-switch" role="group" aria-label={en ? 'Language' : '语言'}>
    <span aria-current="true">{en ? 'EN' : '中文'}</span><span aria-hidden="true"> / </span>
    <a href={switchLocaleRoute(route, other, base)} lang={other} hreflang={other}>{en ? '中文' : 'EN'}</a>
  </div>
</header>
<div class="search-strip"><div class="search-container">
  <form class="search-form" role="search" data-pagefind-search action={pathFor({ type: 'search' }, locale, base)} method="get">
    <label class="sr-only" for="site-search">{en ? 'Search questions, topics, or keywords' : '搜索问题、主题或关键词'}</label>
    <Icon name="search" size={21} class="search-icon" />
    <input id="site-search" name="q" type="search" placeholder={en ? 'Search questions, topics, or keywords' : '搜索问题、主题或关键词'} autocomplete="off" />
    <button type="submit">{en ? 'Search' : '搜索'}</button>
  </form>
  <div class="search-results" aria-live="polite" hidden></div>
</div></div>


<script>
  import '../lib/target-dom';
  import { parseBrowseQuery, serializeBrowseQuery } from '../lib/discovery/query';
  import { translateArticleHash, type SectionTranslation } from '../lib/article-sections';
  import { initTargetSelector } from '../lib/target-selector';
  import { createDiscovery } from '../lib/discovery/search';
  import { createPagefindAdapter } from '../lib/discovery/pagefind-adapter';
  import { withLinkPreference } from '../lib/target-preferences';
  import { getTargetContext, subscribeTarget } from '../lib/target-state';
  import { safeSearchResultHref } from '../lib/search-records';

  initTargetSelector();
  import '../lib/site-navigation-dom';

  const form = document.querySelector<HTMLFormElement>('.search-form');
  const input = form?.querySelector<HTMLInputElement>('input');
  const results = document.querySelector<HTMLElement>('.search-results');
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  const lang = document.documentElement.lang;
  const noResultsText = lang === 'en' ? 'No matching questions.' : '没有找到匹配的问题。';
  const errorText = lang === 'en' ? 'Search is unavailable. Try again.' : '搜索暂时不可用，请重试。';
  const languageLink = document.querySelector<HTMLAnchorElement>('.language-switch a');
  if (languageLink) {
    const syncLanguageLink = () => {
      const current = new URL(window.location.href);
      const target = new URL(languageLink.href, current);
      const parsed = parseBrowseQuery(current, { base, locale: lang === 'en' ? 'zh-CN' : 'en' });
      target.search = new URL(serializeBrowseQuery(parsed.query, target), current).search;
      // Comparison lenses belong to the same question, not the browsing target.
      if (document.body.dataset.routeType === 'question') for (const key of ['targetRole', 'targetStage']) {
        const value = current.searchParams.get(key);
        if (value) target.searchParams.set(key, value);
      }
      const data = document.getElementById('article-section-translations');
      if (data) {
        let sections: SectionTranslation[] = [];
        try { sections = JSON.parse(data.textContent ?? '[]'); } catch { /* Unmapped sections fall back to the translated page. */ }
        const from = lang === 'en' ? 'en' : 'zh-CN';
        target.hash = translateArticleHash(current.hash, from, from === 'en' ? 'zh-CN' : 'en', sections);
      } else target.hash = current.hash;
      languageLink.href = target.href;
    };
    syncLanguageLink();
    languageLink.addEventListener('click', syncLanguageLink);
    window.addEventListener('hashchange', syncLanguageLink);
  }
  type SearchData = { url: string; meta?: { title?: string }; excerpt?: string };
  type SearchResult = { url: string; data: () => Promise<SearchData> };
  type PagefindIndex = { search: (query: string, options: { filters: Record<string, string> }) => Promise<{ results: SearchResult[] }> };
  let pagefind: PagefindIndex | undefined;
  let timer: number | undefined;
  let activeSearch = 0;

  function showSearchMessage(message: string) {
    if (!results) return;
    const paragraph = document.createElement('p');
    paragraph.className = 'search-empty';
    paragraph.textContent = message;
    results.replaceChildren(paragraph);
    results.hidden = false;
  }

  async function search(query: string) {
    const request = ++activeSearch;
    const normalizedQuery = query.trim();
    if (!results || !normalizedQuery) {
      results?.replaceChildren();
      if (results) results.hidden = true;
      return;
    }
    try {
      pagefind ??= await import(/* @vite-ignore */ `${base}/pagefind/pagefind.js`) as PagefindIndex;
      const adapter = createPagefindAdapter(pagefind);
      const query = parseBrowseQuery(new URL(location.href), { base, locale: lang === 'en' ? 'en' : 'zh-CN' }).query;
      query.q = normalizedQuery; query.target = getTargetContext(); query.page = 1;
      const response = await createDiscovery({ catalog: adapter, pagefind: adapter }).search(query, { pageSize: 8 });
      if (request !== activeSearch) return;
      const items = [...response.docs.items.map(item => ({ ...item, group: lang === 'en' ? 'Document' : '文档' })), ...response.questions.items.map(item => ({ ...item, group: lang === 'en' ? 'Question' : '题目' }))];

      const links = items.flatMap((item) => {
        const href = safeSearchResultHref(item.url, { origin: window.location.origin, basePath: base });
        if (!href) return [];
        const link = document.createElement('a');
        link.className = 'search-result';
        const linkUrl = new URL(href, location.origin);
        if (getTargetContext().hasLink) linkUrl.search = withLinkPreference(linkUrl.searchParams, getTargetContext().preference).toString();
        link.href = `${linkUrl.pathname}${linkUrl.search}${linkUrl.hash}`;
        const title = document.createElement('strong');
        title.textContent = `${item.group} · ${item.title}`;
        const excerpt = document.createElement('span');
        excerpt.textContent = new DOMParser().parseFromString(item.excerpt ?? '', 'text/html').body.textContent ?? '';
        link.append(title, excerpt);
        return [link];
      });
      if (links.length) {
        const allLink = document.createElement('a');
        allLink.className = 'search-all';
        const allUrl = new URL(form?.action ?? `${base}/search/`, location.origin); allUrl.searchParams.set('q', normalizedQuery);
        if (getTargetContext().hasLink) allUrl.search = withLinkPreference(allUrl.searchParams, getTargetContext().preference).toString();
        allLink.href = allUrl.href;
        allLink.textContent = lang === 'en' ? 'View all matches' : '查看全部匹配';
        results.replaceChildren(...links, allLink);
        results.hidden = false;
      } else showSearchMessage(noResultsText);
    } catch {
      if (request === activeSearch) showSearchMessage(errorText);
    }
  }

  form?.addEventListener('submit', () => {
    form.querySelectorAll('[data-profile-form-value]').forEach(item => item.remove());
    if (!getTargetContext().hasLink) return;
    const params = withLinkPreference(new URLSearchParams(), getTargetContext().preference);
    for (const [name, value] of params) { const hidden = document.createElement('input'); hidden.type = 'hidden'; hidden.name = name; hidden.value = value; hidden.dataset.profileFormValue = ''; form.append(hidden); }
  });
  const initialQuery = new URLSearchParams(location.search).get('q');
  if (input && initialQuery) input.value = initialQuery;
  subscribeTarget((_context, reset) => { if (reset) { activeSearch++; if (results) { results.replaceChildren(); results.hidden = true; } if (input?.value.trim()) void search(input.value); } });
  input?.addEventListener('input', () => {
    window.clearTimeout(timer);
    if (!input.value.trim()) { void search(''); return; }
    timer = window.setTimeout(() => void search(input.value), 160);
  });
  document.addEventListener('pointerdown', event => {
    if (event.target instanceof Node && !form?.contains(event.target) && !results?.contains(event.target)) {
      activeSearch++; window.clearTimeout(timer); if (results) results.hidden = true;
    }
  });
  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); input?.focus(); }
    if (event.key === 'Escape') {
      activeSearch += 1;
      window.clearTimeout(timer);
      if (results) { results.replaceChildren(); results.hidden = true; }
      input?.blur();
    }
  });
</script>
