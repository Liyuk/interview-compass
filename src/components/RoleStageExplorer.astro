---
import { audienceRoles, pick, type Locale } from '../lib/taxonomy';
import { pathFor } from '../lib/routes';
interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
---
<section class="model-section" aria-labelledby="role-stage-heading">
  <h2 id="role-stage-heading">{en ? 'Start with your role and target responsibility' : '先选岗位，再看目标阶段的责任'}</h2>
  <p>{en ? 'Use one question to examine the judgment, actions, and results expected at several stages. The stage describes responsibility; the 1–4 reference describes response evidence.' : '用同一道题观察多个阶段的判断、行动和结果要求。阶段说明责任范围，1–4 档参考回答证据。'}</p>
  <div class="role-model-links">{audienceRoles.map(role => <a href={pathFor({ type: 'role-stage-model', role: role.id }, locale, import.meta.env.BASE_URL)}>{pick(role.name, locale)}<span>{en ? 'View stages →' : '查看阶段 →'}</span></a>)}</div>
</section>
<style>
  .role-model-links { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: .65rem; margin-top: 1.25rem; }
  .role-model-links a { display:flex; justify-content:space-between; align-items:center; gap:.8rem; padding: .85rem 1rem; border:1px solid var(--line, #d8d5d0); border-radius:4px; text-decoration:none; }
  .role-model-links span { font-size:.8rem; color:var(--muted, #65615b); }
</style>
