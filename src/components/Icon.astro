---
import Search from '@lucide/astro/icons/search';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ArrowLeft from '@lucide/astro/icons/arrow-left';
const icons = { search: Search, 'chevron-right': ChevronRight, 'chevron-down': ChevronDown, 'arrow-up-right': ArrowUpRight, 'arrow-right': ArrowRight, 'arrow-left': ArrowLeft };
interface Props { name: keyof typeof icons; size?: number; class?: string; title?: string }
const { name, size = 18, class: className, title } = Astro.props;
const Glyph = icons[name];
---
<Glyph class={['site-icon', className].filter(Boolean).join(' ')} size={size} stroke-width={1.75} aria-hidden={title ? undefined : 'true'} role={title ? 'img' : undefined} aria-label={title} />
