---
import { pagePresentationFor } from '../lib/page-presentation';
import SiteMasthead from '../components/SiteMasthead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ReadingJourney from '../components/ReadingJourney.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import EditorialNavigation from '../components/docs/EditorialNavigation.astro';
import ReadingNavigation from '../components/docs/ReadingNavigation.astro';
import CurrentCollection from '../components/docs/CurrentCollection.astro';
import ArticleRelations from '../components/docs/ArticleRelations.astro';
import DocumentNavigation from '../components/docs/DocumentNavigation.astro';
import WikiOutline from '../components/WikiOutline.astro';
import { activeNavFor, breadcrumbsFor, pathFor, titleFor, type RouteRef } from '../lib/routes';
import type { Locale } from '../lib/taxonomy';
import { normalizeWikiOutline, type WikiOutlineItem } from '../lib/wiki-outline';

interface Props { locale: Locale; route: RouteRef; description?: string; redirectTo?: string; outline?: WikiOutlineItem[] }
const { locale, route, description = '', redirectTo } = Astro.props;
const outline = normalizeWikiOutline(Astro.props.outline ?? []);
const en = locale === 'en';
const base = import.meta.env.BASE_URL;
const publicBase = base.endsWith('/') ? base : `${base}/`;
const title = titleFor(route, locale);
const pageTitle = route.type === 'home'
  ? `Interview Compass · ${en ? 'A guide to engineering interviews and promotions' : '工程师的面试与晋升指南'}`
  : `${title} · Interview Compass`;
const pageDescription = description || (en ? 'Explore practical questions and guides for engineering interviews and promotions.' : '浏览工程师面试与晋升的实用问题和指南。');
const indexable = !['search', 'not-found'].includes(route.type) && !redirectTo;
const canonicalUrl = new URL(pathFor(route, locale, base), import.meta.env.SITE).href;
const alternateUrls = indexable ? [
  { locale: 'en', url: new URL(pathFor(route, 'en', base), import.meta.env.SITE).href },
  { locale: 'zh-CN', url: new URL(pathFor(route, 'zh-CN', base), import.meta.env.SITE).href },
] : [];
const currentNav = activeNavFor(route);
const active = ['roles', 'topics', 'capabilities'].includes(currentNav) ? 'browse' : currentNav;
const presentation = pagePresentationFor(route);
const hasSidebar = Boolean(presentation.section) || route.type === 'search';
const hasReadingTools = presentation.kind === 'section' || presentation.kind === 'article';
const crumbs = breadcrumbsFor(route, locale, base);
---
<!doctype html>
<html lang={locale} data-pagefind-filter="locale[lang], kind[data-search-kind]" data-search-kind={route.type === 'question' ? 'questions' : 'docs'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={indexable ? 'index,follow' : 'noindex,follow'} />
    {indexable && <link rel="canonical" href={canonicalUrl} />}
    {alternateUrls.map(({ locale: alternateLocale, url }) => <link rel="alternate" hreflang={alternateLocale} href={url} />)}
    {indexable && <link rel="alternate" hreflang="x-default" href={alternateUrls[0].url} />}
    <meta property="og:type" content={['article', 'section'].includes(presentation.kind) ? 'article' : 'website'} />
    <meta property="og:site_name" content="Interview Compass" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={en ? 'en_US' : 'zh_CN'} />
    <meta property="og:locale:alternate" content={en ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="theme-color" content="#fbfaf8" />
    <link rel="icon" type="image/svg+xml" href={`${publicBase}favicon.svg`} />
    <link rel="alternate" type="text/plain" href={`${publicBase}llms.txt`} title="AI crawler overview" />
    {indexable && <script type="application/ld+json" set:html={JSON.stringify([
      {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        '@id': `${canonicalUrl}#webpage`,
        url: canonicalUrl,
        name: pageTitle,
        description: pageDescription,
        inLanguage: locale === 'en' ? 'en' : 'zh-CN',
        isPartOf: { '@id': `${new URL(pathFor({ type: 'home' }, 'en', base), import.meta.env.SITE).href}#website` },
      },
      ...(route.type === 'home' ? [{
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        '@id': `${new URL(pathFor({ type: 'home' }, 'en', base), import.meta.env.SITE).href}#website`,
        url: new URL(pathFor({ type: 'home' }, 'en', base), import.meta.env.SITE).href,
        name: 'Interview Compass',
        inLanguage: locale === 'en' ? 'en' : 'zh-CN',
      }] : []),
      ...(crumbs.length > 1 ? [{
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: crumbs.map((crumb, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: crumb.label,
          item: new URL(crumb.href ?? pathFor(route, locale, base), import.meta.env.SITE).href,
        })),
      }] : []),
    ]).replace(/</g, '\\u003c')} />}
    <title>{pageTitle}</title>
  </head>
  <body data-route-type={route.type} data-page-kind={presentation.kind}>
    <span hidden data-pagefind-sort="title[data-sort-title]" data-sort-title={title} />
    <a class="skip-link" href="#main">{en ? 'Skip to content' : '跳到正文'}</a>
    <SiteMasthead locale={locale} active={active} route={route} wiki={route.type !== 'home'} />
    {route.type === 'home' ? <div class="page-frame">
      <main id="main" class="main-content" data-pagefind-body><slot /></main>
    </div> : <div class="page-frame wiki-page-frame" id={route.type === 'guide' ? '_top' : undefined}>
      <Breadcrumbs crumbs={crumbs} locale={locale} />
      <div class:list={['wiki-reading-grid', { 'has-section-nav': hasSidebar, 'has-outline': outline.length > 0 }]}>
        {hasSidebar && <DocumentNavigation route={route} locale={locale} />}
        <main id="main" class="main-content" data-pagefind-body={route.type !== 'question'} data-pagefind-ignore={['search', 'questions', 'not-found'].includes(route.type) ? 'all' : undefined}><slot />{hasReadingTools && <ArticleRelations route={route} locale={locale} />}
          {hasReadingTools && route.type !== 'question' && <EditorialNavigation route={route} locale={locale} />}
          {route.type === 'question' && <ReadingNavigation locale={locale} questionId={route.questionId} />}
          {['question', 'collections', 'questions', 'search'].includes(route.type) && <CurrentCollection locale={locale} questionId={route.type === 'question' ? route.questionId : undefined} />}</main>
        <WikiOutline items={outline} locale={locale} />
      </div>
    </div>}
    <SiteFooter locale={locale} />
    <ReadingJourney />
  </body>
</html>
