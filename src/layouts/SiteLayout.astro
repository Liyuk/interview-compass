---
import { pagePresentationFor } from '../lib/page-presentation';
import SiteMasthead from '../components/SiteMasthead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ReadingJourney from '../components/ReadingJourney.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import WikiSidebar from '../components/WikiSidebar.astro';
import WikiOutline from '../components/WikiOutline.astro';
import { activeNavFor, breadcrumbsFor, titleFor, type RouteRef } from '../lib/routes';
import type { Locale } from '../lib/taxonomy';
import { normalizeWikiOutline, type WikiOutlineItem } from '../lib/wiki-outline';

interface Props { locale: Locale; route: RouteRef; description?: string; redirectTo?: string; outline?: WikiOutlineItem[] }
const { locale, route, description = '', redirectTo } = Astro.props;
const outline = normalizeWikiOutline(Astro.props.outline ?? []);
const en = locale === 'en';
const base = import.meta.env.BASE_URL;
const publicBase = base.endsWith('/') ? base : `${base}/`;
const title = titleFor(route, locale);
const currentNav = activeNavFor(route);
const active = ['roles', 'topics', 'capabilities'].includes(currentNav) ? 'browse' : currentNav;
const presentation = pagePresentationFor(route);
const hasSidebar = presentation.kind === 'section';
const crumbs = breadcrumbsFor(route, locale, base);
---
<!doctype html>
<html lang={locale} data-pagefind-filter="locale[lang]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfaf8" />
    {redirectTo && <><meta http-equiv="refresh" content={`0;url=${redirectTo}`} /><link rel="canonical" href={redirectTo} /></>}
    <link rel="icon" type="image/svg+xml" href={`${publicBase}favicon.svg`} />
    <title>{route.type === 'home' ? 'Interview Compass' : `${title} · Interview Compass`}</title>
  </head>
  <body data-route-type={route.type} data-page-kind={presentation.kind}>
    <a class="skip-link" href="#main">{en ? 'Skip to content' : '跳到正文'}</a>
    <SiteMasthead locale={locale} active={active} route={route} wiki={route.type !== 'home'} />
    {route.type === 'home' ? <div class="page-frame">
      <main id="main" class="main-content"><slot /></main>
    </div> : <div class="page-frame wiki-page-frame">
      <Breadcrumbs crumbs={crumbs} locale={locale} />
      <div class:list={['wiki-reading-grid', { 'has-section-nav': hasSidebar, 'has-outline': outline.length > 0 }]}>
        {hasSidebar && <WikiSidebar route={route} locale={locale} base={base} section={presentation.section} />}
        <main id="main" class="main-content"><slot /></main>
        <WikiOutline items={outline} locale={locale} />
      </div>
    </div>}
    <SiteFooter locale={locale} />
    <ReadingJourney />
  </body>
</html>
