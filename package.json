{
  "name": "interview-compass",
  "version": "1.0.0",
  "private": true,
  "author": "Liyuk",
  "description": "A bilingual, question-first library for external interviews and internal promotion preparation.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build:site": "astro build && node scripts/copy-legal-files.mjs",
    "build:search": "pagefind --site dist --output-subdir pagefind",
    "build": "npm run build:site && npm run build:search",
    "preview": "astro preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check:content": "node scripts/check-content.mjs",
    "check:size": "node scripts/check-size.mjs",
    "report:coverage": "node scripts/coverage-report.mjs",
    "prepare:stage-applicability": "node scripts/prepare-stage-applicability.mjs",
    "report:stage-coverage": "node scripts/stage-coverage-report.mjs",
    "check:stage-coverage": "node scripts/stage-coverage-report.mjs --require-complete",
    "check": "astro check",
    "ci": "npm run check && npm run check:content && npm run check:stage-coverage && npm run test:unit && npm run build && npm run check:size && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.6",
    "astro": "7.4.0",
    "pagefind": "1.5.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.1",
    "js-yaml": "^4.3.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  }
}
