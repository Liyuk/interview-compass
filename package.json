{
  "name": "interview-compass",
  "version": "2.0.0",
  "private": true,
  "description": "A bilingual, question-first interview and promotion reflection library.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build:site": "astro build",
    "build:search": "pagefind --site dist --output-subdir pagefind",
    "build": "npm run build:site && npm run build:search",
    "preview": "astro preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check:content": "node scripts/check-content.mjs",
    "check": "astro check",
    "ci": "npm run check && npm run check:content && npm run test:unit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@astrojs/starlight": "0.42.6",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/themes": "3.3.0",
    "astro": "7.3.8",
    "pagefind": "1.5.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "js-yaml": "^4.3.2",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
